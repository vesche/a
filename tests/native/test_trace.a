; Runtime failures: `try { }` catches them, and an uncaught one prints an
; a-level stack trace (`at fn (file:line)`), innermost frame first.
; `a build --release` compiles the trace machinery out.

use std.testing

fn boom(n: int) -> int {
  if n == 0 { fail("zero") }
  ret 10 / n
}

fn main() {
  ; --- try catches every kind of runtime failure ---
  testing.assert_eq(try { fail("boom") }, Err("boom"))
  testing.assert_eq(try { 1 / 0 }, Err("division by zero"))
  testing.assert_eq(try { unwrap(Err("e")) }, Err("e"))
  testing.assert_eq(try { boom(0) }, Err("zero"))
  testing.assert_eq(try { boom(5) }, Ok(2))
  ; a failure inside a lambda inside a builtin is still caught by the enclosing try
  testing.assert_eq(try { map([1, 0], fn(v) => 10 / v) }, Err("division by zero"))
  ; catching does not corrupt the frame stack: later failures still trace to here
  let after = try { boom(0) }
  testing.assert_eq(is_err(after), true)
  println("PASS: try catches runtime failures")

  ; --- an uncaught failure prints the message and the trace to stderr ---
  if !fs.exists("./a") { fail("./a binary not found -- run from project root") }
  let dir = "/tmp/a_trace_test_" + to_str(time.now())
  fs.mkdir(dir)
  let prog = dir + "/crash.a"
  io.write_file(prog, str.join([
    "fn parse_num(s: str) -> int \{",
    "  if s == \"x\" \{ fail(\"not a number: \" + s) \}",
    "  ret int(s)",
    "\}",
    "fn total(xs: [str]) -> int \{",
    "  let mut t = 0",
    "  for x in xs \{",
    "    t = t + parse_num(x)",
    "  \}",
    "  ret t",
    "\}",
    "fn main() \{",
    "  println(total([\"1\", \"2\"]))",
    "  let f = fn(v) => total([v])",
    "  println(f(\"x\"))",
    "\}"
  ], "\n") + "\n")
  let r = exec_timeout("./a run " + prog, 60000)
  testing.assert_eq(r["code"], 1)
  testing.assert_eq(str.trim(r["stdout"]), "3")
  let err = r["stderr"]
  testing.assert_eq(str.contains(err, "runtime error: not a number: x\n"), true)
  testing.assert_eq(str.contains(err, "  at parse_num (" + prog + ":2)\n"), true)
  testing.assert_eq(str.contains(err, "  at total (" + prog + ":8)\n"), true)
  testing.assert_eq(str.contains(err, "  at <lambda in main> (" + prog + ":14)\n"), true)
  testing.assert_eq(str.contains(err, "  at main (" + prog + ":15)\n"), true)
  println("PASS: uncaught failure prints a stack trace")

  ; --- --release: same message, no trace ---
  let bin = dir + "/crash"
  let b = exec_timeout("./a build " + prog + " --release -o " + bin, 120000)
  testing.assert_eq(b["code"], 0)
  let r2 = exec_timeout(bin, 60000)
  testing.assert_eq(r2["code"], 1)
  testing.assert_eq(str.contains(r2["stderr"], "runtime error: not a number: x"), true)
  testing.assert_eq(str.contains(r2["stderr"], "  at "), false)
  println("PASS: --release strips the trace")

  ; --- an Err that propagates out of main still has a trace ---
  let errp = dir + "/errmain.a"
  io.write_file(errp, "fn boom() \{ ret Err(\"deep\") \}\nfn main() \{ boom()? \}\n")
  let re = exec_timeout("./a run " + errp, 60000)
  testing.assert_eq(re["code"], 1)
  testing.assert_eq(str.contains(re["stderr"], "error: deep"), true)
  testing.assert_eq(str.contains(re["stderr"], "  at main (" + errp), true)
  println("PASS: Err escaping main prints a stack trace")

  fs.rm(prog)
  fs.rm(bin)
  fs.rm(errp)
  fs.rm(dir)
}
