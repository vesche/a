; scripts/gen_builtin_arity.a -- generate std/compiler/builtin_arity.a
;
;   ./a run scripts/gen_builtin_arity.a > std/compiler/builtin_arity.a
;
; The checker needs to know how many arguments each builtin takes. Rather than
; maintain that table by hand (it drifted: the old one said http.post took 2),
; derive it from the C prototypes in c_runtime/runtime.h, mapped through the
; same name table the code generator uses. CI regenerates this file and fails
; if it differs from the committed one.

use std.compiler.cgen

; "AValue a_foo(AValue a, AValue b);" -> ["a_foo", 2]; void for no params;
; variadic prototypes are skipped (arity is not fixed).
fn _proto(line: str) -> [any] {
  let sp = str.find(line, " ")
  if sp < 0 { ret [] }
  let ret_type = str.slice(line, 0, sp)
  if ret_type != "AValue" && ret_type != "void" && ret_type != "int" && ret_type != "bool" { ret [] }
  let rest = str.slice(line, sp + 1, len(line))
  let lp = str.find(rest, "(")
  let rp = str.find(rest, ")")
  if lp <= 0 || rp < lp { ret [] }
  let name = str.trim(str.slice(rest, 0, lp))
  if !str.starts_with(name, "a_") || str.contains(name, "*") { ret [] }
  let params = str.trim(str.slice(rest, lp + 1, rp))
  if str.contains(params, "...") { ret [] }
  if params == "" || params == "void" { ret [name, 0] }
  ret [name, len(str.split(params, ","))]
}

fn main() {
  let header = io.read_file("c_runtime/runtime.h")
  if type_of(header) != "str" { fail("cannot read c_runtime/runtime.h") }
  let mut c_arity = #{}
  for line in str.lines(header) {
    let p = _proto(line)
    if len(p) == 2 { c_arity = map.set(c_arity, p[0], p[1]) }
  }

  let bm = cgen._builtin_map()
  let mut out = "; GENERATED by scripts/gen_builtin_arity.a from c_runtime/runtime.h -- do not edit.\n"
  out = out + "; Builtin name -> number of arguments, for builtins with a fixed arity.\n\n"
  out = out + "fn table() -> map \{\n  ret #\{\n"
  let mut first = true
  for name in sort(map.keys(bm)) {
    let cfn = bm[name]
    if !map.has(c_arity, cfn) { continue }
    if !first { out = out + ",\n" }
    out = out + "    \"" + name + "\": " + to_str(c_arity[cfn])
    first = false
  }
  out = out + "\n  \}\n\}\n"
  print(out)
}
