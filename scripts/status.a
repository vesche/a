; scripts/status.a -- generate STATUS.md: what the compiler actually implements,
; cross-checked against what REFERENCE.md documents and what tests exercise.
;
;   ./a run scripts/status.a > STATUS.md
;
; The source of truth for "implemented" is cgen._builtin_map(): a name the
; code generator does not know cannot be called from an `a` program, however
; nicely the docs describe it. Documentation is read from the `| `name(...)` |`
; table rows of REFERENCE.md. A builtin counts as tested if any file under
; tests/native/ calls it.

use std.compiler.cgen

fn _read_reference() -> str {
  let src = io.read_file("REFERENCE.md")
  if type_of(src) != "str" { fail("cannot read REFERENCE.md") }
  ret src
}

; Names documented as builtins: table rows whose first cell is `name(`.
fn _documented_builtins(ref: str) -> map {
  let mut out = #{}
  let mut in_builtins = false
  for line in str.lines(ref) {
    ; only the "Builtin Functions Reference" section; the standard library
    ; section that follows documents `a`-level functions, not builtins
    if str.starts_with(line, "## ") {
      in_builtins = str.contains(line, "Builtin Functions")
      continue
    }
    if !in_builtins { continue }
    if !str.starts_with(line, "| `") { continue }
    let rest = str.slice(line, 3, len(line))
    let paren = str.find(rest, "(")
    let tick = str.find(rest, "`")
    if tick <= 0 { continue }
    let mut end = tick
    if paren > 0 && paren < tick { end = paren }
    let name = str.slice(rest, 0, end)
    if len(name) == 0 || str.contains(name, " ") { continue }
    out = map.set(out, name, true)
  }
  ret out
}

; `### std.name` headings in the standard library section.
fn _documented_std_modules(ref: str) -> map {
  let mut out = #{}
  for line in str.lines(ref) {
    if str.starts_with(line, "### std.") {
      out = map.set(out, str.slice(line, 8, len(line)), true)
    }
  }
  ret out
}

fn _list_a_files(dir: str) -> [str] {
  let mut out = []
  if !fs.exists(dir) { ret out }
  for e in fs.ls(dir) {
    if !e["is_dir"] && str.ends_with(e["name"], ".a") {
      out = push(out, e["name"])
    }
  }
  ret sort(out)
}

fn _read_all_tests() -> str {
  let mut all = ""
  for f in _list_a_files("tests/native") {
    let src = io.read_file("tests/native/" + f)
    if type_of(src) == "str" { all = all + "\n" + src }
  }
  ret all
}

fn _namespace_of(name: str) -> str {
  let dot = str.find(name, ".")
  if dot < 0 { ret "(core)" }
  ret str.slice(name, 0, dot)
}

fn _mark(b: bool) -> str {
  if b { ret "yes" }
  ret "-"
}

fn main() {
  let ref = _read_reference()
  let documented = _documented_builtins(ref)
  let std_documented = _documented_std_modules(ref)
  let tests = _read_all_tests()

  ; `exit` is handled directly by the code generator rather than via the map
  let bm = map.set(cgen._builtin_map(), "exit", "a_exit")
  let implemented = sort(map.keys(bm))

  ; group by namespace
  let mut by_ns = #{}
  let mut ns_order = []
  for name in implemented {
    let ns = _namespace_of(name)
    if !map.has(by_ns, ns) {
      by_ns = map.set(by_ns, ns, [])
      ns_order = push(ns_order, ns)
    }
    by_ns = map.set(by_ns, ns, push(by_ns[ns], name))
  }

  let mut n_doc = 0
  let mut n_tested = 0
  let mut undocumented = []
  let mut untested = []
  for name in implemented {
    let d = map.has(documented, name)
    let t = str.contains(tests, name + "(")
    if d { n_doc = n_doc + 1 } else { undocumented = push(undocumented, name) }
    if t { n_tested = n_tested + 1 } else { untested = push(untested, name) }
  }

  let mut phantom = []
  for name in sort(map.keys(documented)) {
    if !map.has(bm, name) { phantom = push(phantom, name) }
  }

  let mut out = ""
  out = out + "# a -- implementation status\n\n"
  out = out + "Generated by `./a run scripts/status.a > STATUS.md`. Do not edit by hand.\n\n"
  out = out + "\"Implemented\" means the native compiler (`std/compiler/cgen.a`) knows the name.\n"
  out = out + "\"Documented\" means REFERENCE.md has a table row for it. \"Tested\" means some\n"
  out = out + "file under `tests/native/` calls it. Anything documented but not implemented\n"
  out = out + "is a documentation bug, listed at the bottom so it cannot hide.\n\n"

  out = out + "## Summary\n\n"
  out = out + "| | count |\n|---|---|\n"
  out = out + "| builtins implemented | " + to_str(len(implemented)) + " |\n"
  out = out + "| ... documented | " + to_str(n_doc) + " |\n"
  out = out + "| ... exercised by a native test | " + to_str(n_tested) + " |\n"
  out = out + "| documented but NOT implemented | " + to_str(len(phantom)) + " |\n\n"

  out = out + "## Builtins\n\n"
  for ns in ns_order {
    out = out + "### " + ns + "\n\n"
    out = out + "| builtin | documented | tested |\n|---|---|---|\n"
    for name in by_ns[ns] {
      out = out + "| `" + name + "` | " + _mark(map.has(documented, name)) + " | " + _mark(str.contains(tests, name + "(")) + " |\n"
    }
    out = out + "\n"
  }

  out = out + "## Standard library modules\n\n"
  out = out + "| module | documented | has test |\n|---|---|---|\n"
  for f in _list_a_files("std") {
    let modname = str.slice(f, 0, len(f) - 2)
    let has_test = fs.exists("tests/native/test_" + modname + ".a") || str.contains(tests, "use std." + modname + "\n")
    out = out + "| `std." + modname + "` | " + _mark(map.has(std_documented, modname)) + " | " + _mark(has_test) + " |\n"
  }
  out = out + "\n"

  out = out + "## Documented but not implemented\n\n"
  if len(phantom) == 0 {
    out = out + "None.\n\n"
  } else {
    out = out + "These appear in REFERENCE.md tables but the compiler does not know them.\n"
    out = out + "Either implement them or delete the rows.\n\n"
    for name in phantom { out = out + "- `" + name + "`\n" }
    out = out + "\n"
  }

  out = out + "## Implemented but undocumented\n\n"
  if len(undocumented) == 0 {
    out = out + "None.\n\n"
  } else {
    for name in undocumented { out = out + "- `" + name + "`\n" }
    out = out + "\n"
  }

  out = out + "## Implemented but untested\n\n"
  if len(untested) == 0 {
    out = out + "None.\n"
  } else {
    for name in untested { out = out + "- `" + name + "`\n" }
  }

  print(out)
}
