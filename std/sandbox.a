; std/sandbox.a -- run untrusted `a` code under a capability set.
;
; The decision is made by effect inference, not by rewriting source: the
; program (and every module it uses) is parsed, checked, and its whole-program
; effect set computed (std/compiler/effect_check.a). If that set contains an
; effect the capabilities do not grant, the program is refused before it is
; compiled. There is nothing to bypass: every builtin that touches the outside
; world carries its effect in std/compiler/builtin_sigs.a, and every call site
; of every function in the program is attributed to something reachable from
; main.
;
; What this does NOT do: restrict *which* files or hosts a granted effect may
; reach. `fs_read: true` means the program may read any file the process can.
; Path- or host-level restriction needs an OS sandbox, not a compiler.
;
; Capabilities: #{
;   "io": bool        stdout/stderr/stdin              (default true)
;   "time": bool      clock, sleep                     (default true)
;   "rand": bool      uuid                             (default true)
;   "fs_read": bool   read files/directories           (default false)
;   "fs_write": bool  create/modify/delete files       (default false)
;   "net": bool       http/ws client and server        (default false)
;   "exec": bool      run programs, shells             (default false)
;   "db": bool        sqlite                           (default false)
;   "env": bool       environment, process info        (default false)
;   "spawn": bool     tasks, signal handlers           (default false)
;   "ffi": bool       raw pointers, extern fn          (default false)
;   "max_output": int bytes of stdout kept             (default 65536)
;   "timeout_ms": int deadline for the run             (default 5000)
; }

use std.compiler.parser
use std.compiler.checker
use std.compiler.effect_check
use std.compiler.builtin_sigs

fn capabilities(opts) -> map {
  let mut c = #{
    "io": true, "time": true, "rand": true,
    "fs_read": false, "fs_write": false, "net": false, "exec": false,
    "db": false, "env": false, "spawn": false, "ffi": false,
    "max_output": 65536,
    "timeout_ms": 5000
  }
  for k in map.keys(opts) { c = map.set(c, k, opts[k]) }
  ret c
}

; Compute-and-print only.
fn deny_all() -> map { ret capabilities(#{}) }

fn allow_all() -> map {
  let mut c = capabilities(#{"timeout_ms": 30000})
  for e in builtin_sigs.effect_names() { c = map.set(c, e, true) }
  ret c
}

fn allow_read_only() -> map { ret capabilities(#{"fs_read": true}) }

fn allow_network() -> map { ret capabilities(#{"net": true}) }

; Effects of `source` that `caps` does not grant. `call` (a closure of unknown
; origin) is not itself denied: whatever that closure does is attributed to the
; function that created it, which is in the same program.
fn denied_effects(program_effects: [str], caps: map) -> [str] {
  let mut out = []
  for e in program_effects {
    if e == "call" { continue }
    if map.has(caps, e) && caps[e] == true { continue }
    out = push(out, e)
  }
  ret out
}

; Wraps bare statements in `fn main() { ... }` so snippets can be run.
fn _as_program(source: str) -> str {
  if str.contains(source, "fn main(") { ret source }
  ret "fn main() \{\n" + source + "\n\}\n"
}

; Parse + check + infer. Returns #{"ok": bool, "effects": [str], "errors": [str], "ast": map}.
fn analyze(source: str) -> map {
  let ast = parser.parse(_as_program(source))
  if type_of(ast) != "map" || ast["tag"] != "Program" {
    let mut msg = "parse error"
    if type_of(ast) == "map" && map.has(ast, "msg") { msg = to_str(ast["line"]) + ":" + to_str(ast["col"]) + ": " + ast["msg"] }
    ret #{"ok": false, "effects": [], "errors": [msg], "ast": #{}}
  }
  let mut errors = []
  for d in checker.check(ast) {
    if d["severity"] == "error" { errors = push(errors, checker.format_diag("<sandbox>", d)) }
  }
  if len(errors) > 0 { ret #{"ok": false, "effects": [], "errors": errors, "ast": ast} }
  let r = effect_check.analyze(ast)
  ret #{"ok": true, "effects": r["program"], "errors": [], "ast": ast}
}

; Static verdict without running: #{"safe": bool, "effects": [str], "issues": [map]}.
; "safe" means the program needs nothing beyond deny_all().
fn validate(source) -> map {
  let a = analyze(source)
  let mut issues = []
  for e in a["errors"] { issues = push(issues, #{"severity": "error", "message": e}) }
  let denied = denied_effects(a["effects"], deny_all())
  for e in denied { issues = push(issues, #{"severity": "warning", "message": "needs " + e + ": " + _describe(e)}) }
  ret #{"safe": a["ok"] && len(denied) == 0, "effects": a["effects"], "issues": issues, "issue_count": len(issues)}
}

fn _describe(e: str) -> str {
  let d = #{
    "io": "reads stdin or writes to stdout/stderr",
    "fs_read": "reads the filesystem", "fs_write": "writes the filesystem",
    "net": "uses the network", "exec": "runs other programs", "db": "opens a database",
    "env": "reads or writes environment variables", "spawn": "starts tasks or handles signals",
    "time": "reads the clock", "rand": "uses randomness", "ffi": "uses raw pointers or extern functions"
  }
  if map.has(d, e) { ret d[e] }
  ret e
}

; Refuses (ok: false, denied: [...]) or runs under the deadline.
fn run(source, caps) -> map {
  let a = analyze(source)
  if !a["ok"] {
    ret #{"ok": false, "code": 1, "stdout": "", "stderr": "sandbox: " + str.join(a["errors"], "\n"), "denied": [], "effects": [], "timed_out": false}
  }
  let denied = denied_effects(a["effects"], caps)
  if len(denied) > 0 {
    ret #{"ok": false, "code": 1, "stdout": "",
      "stderr": "sandbox: program needs " + str.join(denied, ", ") + " which the capabilities do not grant",
      "denied": denied, "effects": a["effects"], "timed_out": false}
  }
  let tmp_file = "/tmp/a_sandbox_" + to_str(time.now()) + "_" + to_str(reflect.pid()) + ".a"
  io.write_file(tmp_file, _as_program(source))
  let r = exec_timeout(_find_cli() + " run " + tmp_file, caps["timeout_ms"])
  fs.rm(tmp_file)
  let mut out = r["stdout"]
  if len(out) > caps["max_output"] { out = str.slice(out, 0, caps["max_output"]) }
  let mut stderr = r["stderr"]
  if r["timed_out"] { stderr = stderr + "\nsandbox: killed after " + to_str(caps["timeout_ms"]) + " ms" }
  ret #{"ok": r["code"] == 0, "code": r["code"], "stdout": out, "stderr": stderr,
    "denied": [], "effects": a["effects"], "timed_out": r["timed_out"]}
}

fn run_file(fpath, caps) -> map {
  let src = io.read_file(fpath)
  if is_err(src) {
    ret #{"ok": false, "code": 1, "stdout": "", "stderr": "sandbox: cannot read " + fpath,
      "denied": [], "effects": [], "timed_out": false}
  }
  ret run(src, caps)
}

fn _find_cli() -> str {
  if fs.exists("./a") { ret "./a" }
  let which = exec_timeout("which a", 5000)
  if which["code"] == 0 { ret str.trim(which["stdout"]) }
  ret "a"
}
