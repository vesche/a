; std/compiler/cgen.a -- C code generation backend
; Reads an "a" source file, parses to AST, emits C source to stdout.
; Supports `use` module inlining, closures/lambdas, HOFs, pipes.
; Usage: a run std/compiler/cgen.a -- input.a > output.c

use std.compiler.builtin_sigs
use std.compiler.parser
use std.compiler.ast

; Builtin name -> C function name mapping
; Optional trailing builtin arguments come from std/compiler/builtin_sigs.a.
fn _builtin_min_arity() -> map { ret builtin_sigs.min_arity() }

; Number of parameters in a signature string such as "fn(str, [T]) -> map".
fn _sig_param_count(sig: str) -> int {
  let inner = str.slice(sig, str.find(sig, "(") + 1, len(sig))
  let mut depth = 0
  let mut count = 0
  let mut seen = false
  for c in str.chars(inner) {
    if c == "(" || c == "[" || c == "<" || c == "\{" { depth = depth + 1 }
    else if c == ")" || c == "]" || c == ">" || c == "\}" {
      if depth == 0 { break }
      depth = depth - 1
    }
    else if c == "," && depth == 0 { count = count + 1 }
    else if c != " " { seen = true }
  }
  if !seen { ret 0 }
  ret count + 1
}

fn _builtin_full_arity(name: str) -> int {
  let sigs = builtin_sigs.sigs()
  if map.has(sigs, name) { ret _sig_param_count(sigs[name]) }
  ret -1
}

fn _builtin_map() -> map {
  let m = #{
    "println": "a_println", "print": "a_print", "eprintln": "a_eprintln",
    "len": "a_len", "push": "a_array_push", "to_str": "a_to_str",
    "fail": "a_fail", "type_of": "a_type_of", "int": "a_to_int", "float": "a_to_float",
    "sort": "a_sort", "contains": "a_contains", "reverse_arr": "a_reverse_arr",
    "concat_arr": "a_concat_arr", "args": "a_args", "slice": "a_array_slice",
    "char_code": "a_char_code", "from_code": "a_from_code",
    "is_alpha": "a_is_alpha", "is_digit": "a_is_digit", "is_alnum": "a_is_alnum",
    "Ok": "a_ok", "Err": "a_err", "unwrap": "a_unwrap", "expect": "a_expect",
    "is_ok": "a_is_ok", "is_err": "a_is_err", "unwrap_or": "a_unwrap_or"
  }
  let m2 = #{
    "str.concat": "a_str_concat", "str.split": "a_str_split",
    "str.contains": "a_str_contains", "str.replace": "a_str_replace",
    "str.trim": "a_str_trim", "str.upper": "a_str_upper", "str.lower": "a_str_lower",
    "str.join": "a_str_join", "str.chars": "a_str_chars", "str.slice": "a_str_slice",
    "str.starts_with": "a_str_starts_with", "str.ends_with": "a_str_ends_with",
    "str.find": "a_str_find", "str.count": "a_str_count", "str.lines": "a_str_lines",
    "map.get": "a_map_get", "map.set": "a_map_set", "map.has": "a_map_has",
    "map.keys": "a_map_keys", "map.values": "a_map_values", "map.merge": "a_map_merge",
    "map.delete": "a_map_delete", "map.entries": "a_map_entries", "map.from_entries": "a_map_from_entries"
  }
  let m3 = #{
    "io.read_file": "a_io_read_file", "io.write_file": "a_io_write_file",
    "io.read_stdin": "a_io_read_stdin", "io.read_line": "a_io_read_line",
    "io.read_bytes": "a_io_read_bytes", "io.flush": "a_io_flush",
    "fs.ls": "a_fs_ls", "fs.mkdir": "a_fs_mkdir", "fs.cwd": "a_fs_cwd",
    "fs.exists": "a_fs_exists", "fs.is_dir": "a_fs_is_dir",
    "fs.rm": "a_fs_rm", "fs.mv": "a_fs_mv", "fs.cp": "a_fs_cp",
    "fs.abs": "a_fs_abs", "fs.is_file": "a_fs_is_file",
    "fs.stat": "a_fs_stat", "fs.watch": "a_fs_watch",
    "exec": "a_exec", "exec_timeout": "a_exec_timeout",
    "proc.spawn": "a_proc_spawn", "proc.exec": "a_proc_exec", "proc.write": "a_proc_write",
    "proc.read_line": "a_proc_read_line", "proc.kill": "a_proc_kill",
    "proc.wait": "a_proc_wait", "proc.is_running": "a_proc_is_running",
    "env.get": "a_env_get",
    "env.set": "a_env_set", "env.all": "a_env_all",
    "json.parse": "a_json_parse",
    "json.stringify": "a_json_stringify", "json.pretty": "a_json_pretty"
  }
  let m4 = #{
    "math.sqrt": "a_math_sqrt", "math.abs": "a_math_abs",
    "math.floor": "a_math_floor", "math.ceil": "a_math_ceil", "math.round": "a_math_round",
    "math.pow": "a_math_pow", "math.min": "a_math_min", "math.max": "a_math_max",
    "time.now": "a_time_now", "time.sleep": "a_time_sleep",
    "hash.sha256": "a_hash_sha256", "hash.md5": "a_hash_md5",
    "uuid.v4": "a_uuid_v4", "signal.on": "a_signal_on",
    "image.load": "a_image_load", "image.decode": "a_image_decode",
    "image.save": "a_image_save", "image.encode": "a_image_encode",
    "image.width": "a_image_width", "image.height": "a_image_height",
    "image.resize": "a_image_resize", "image.pixels": "a_image_pixels",
    "http.get": "a_http_get", "http.post": "a_http_post",
    "http.put": "a_http_put", "http.patch": "a_http_patch", "http.delete": "a_http_delete",
    "http.stream": "a_http_stream", "http.stream_read": "a_http_stream_read", "http.stream_close": "a_http_stream_close",
    "ws.connect": "a_ws_connect", "ws.send": "a_ws_send", "ws.recv": "a_ws_recv", "ws.close": "a_ws_close",
    "http.serve": "a_http_serve", "http.serve_static": "a_http_serve_static",
    "db.open": "a_db_open", "db.close": "a_db_close", "db.exec": "a_db_exec", "db.query": "a_db_query",
    "map": "a_hof_map", "filter": "a_hof_filter", "reduce": "a_hof_reduce",
    "each": "a_hof_each", "sort_by": "a_hof_sort_by", "find": "a_hof_find",
    "any": "a_hof_any", "all": "a_hof_all", "flat_map": "a_hof_flat_map",
    "min_by": "a_hof_min_by", "max_by": "a_hof_max_by",
    "enumerate": "a_enumerate", "zip": "a_zip",
    "take": "a_take", "drop": "a_drop", "unique": "a_unique", "chunk": "a_chunk",
    "ptr.null": "a_ptr_null", "ptr.is_null": "a_is_null",
    "argv0": "a_argv0",
    "embedded_file": "a_embedded_file",
    "compress.deflate": "a_compress_deflate", "compress.inflate": "a_compress_inflate",
    "compress.gzip": "a_compress_gzip", "compress.gunzip": "a_compress_gunzip",
    "spawn": "a_spawn", "await": "a_await", "await_all": "a_await_all",
    "parallel_map": "a_parallel_map", "parallel_each": "a_parallel_each",
    "timeout": "a_timeout",
    "async.http_get": "a_async_http_get", "async.http_post": "a_async_http_post",
    "async.http_put": "a_async_http_put", "async.http_patch": "a_async_http_patch",
    "async.http_delete": "a_async_http_delete",
    "async.await": "a_async_await", "async.gather": "a_async_gather",
    "reflect.uptime_ms": "a_reflect_uptime_ms", "reflect.memory_usage": "a_reflect_memory_usage",
    "reflect.pid": "a_reflect_pid",
    "local_llm.load": "a_llm_load", "local_llm.generate": "a_llm_generate",
    "local_llm.embed": "a_llm_embed", "local_llm.unload": "a_llm_unload",
    "local_llm.info": "a_llm_info", "local_llm.tokenize": "a_llm_tokenize",
    "local_llm.detokenize": "a_llm_detokenize", "local_llm.vocab_size": "a_llm_vocab_size",
    "profile.dump": "a_profile_dump_json", "profile.get_counters": "a_profile_get_counters",
    "profile.reset": "a_profile_reset"
  }
  ret map.merge(map.merge(map.merge(m, m2), m3), m4)
}

fn _void_builtins() -> [str] {
  ret ["println", "print", "eprintln", "fail", "each", "parallel_each", "env.set", "time.sleep", "io.flush", "http.serve", "http.serve_static", "db.close", "fs.watch"]
}

fn _c_keywords() -> [str] {
  ret ["short", "long", "int", "float", "double", "void", "char", "auto",
       "do", "default", "register", "signed", "unsigned", "const", "static",
       "extern", "case", "switch", "goto", "struct", "union", "enum",
       "typedef", "sizeof", "volatile", "inline", "restrict"]
}

fn _mangle(name: str) -> str {
  let out = str.replace(str.replace(name, ".", "_"), "-", "_")
  if contains(_c_keywords(), out) { ret str.concat("_", out) }
  ret out
}

fn _bslash() -> str { ret from_code(92) }
fn _dquote() -> str { ret from_code(34) }
fn _newline_char() -> str { ret from_code(10) }
fn _tab_char() -> str { ret from_code(9) }
fn _cr_char() -> str { ret from_code(13) }

fn _escape_c_str(s: str) -> str {
  let bs = _bslash()
  let out = str.replace(s, bs, str.concat(bs, bs))
  out = str.replace(out, _dquote(), str.concat(bs, _dquote()))
  out = str.replace(out, _newline_char(), str.concat(bs, "n"))
  out = str.replace(out, _cr_char(), str.concat(bs, "r"))
  out = str.replace(out, _tab_char(), str.concat(bs, "t"))
  ret out
}

fn _indent(depth: int) -> str {
  let mut out = ""
  let mut i = 0
  while i < depth {
    out = str.concat(out, "    ")
    i = i + 1
  }
  ret out
}

; ctx = #{"prefix": "parser", "fns": ["parse", ...]}
; prefix="" for main file, "modname" for imported modules

fn _prefixed_name(name, ctx) -> str {
  let prefix = ctx["prefix"]
  if type_of(prefix) == "str" {
    if len(prefix) > 0 {
      ret str.concat(prefix, str.concat("_", name))
    }
  }
  ret name
}

fn _is_intra_module_call(fname, ctx) -> bool {
  let prefix = ctx["prefix"]
  if type_of(prefix) != "str" { ret false }
  if len(prefix) == 0 { ret false }
  if str.contains(fname, ".") { ret false }
  let fns = ctx["fns"]
  if type_of(fns) == "array" {
    ret contains(fns, fname)
  }
  ret false
}

; --- Result triple: [code, lambda_id, [lifted_fns]] ---
; All emit functions return this so lambda state threads correctly.

fn _R(code, li) { ret [code, li, []] }
fn _RL(code, li, lifted) { ret [code, li, lifted] }

; Ownership model of the generated C: every runtime/user call returns an owned
; reference and borrows its arguments; a variable owns exactly one reference
; (retained on `let x = y`, released on reassignment and at function exit).
; A call result that is merely passed on (`f(g(x))`, `s + to_str(n)`, `[h()]`)
; is therefore an owned reference nobody will release. _tmp wraps such
; sub-expressions in A_T(), which parks the reference on the runtime's
; temporary stack; emit_stmt flushes it after every statement. Variables and
; scalar literals are borrowed/valueless and pass through untouched.
fn _tmp(node, code: str, ctx) -> str {
  if type_of(node) != "map" { ret code }
  let t = node["tag"]
  if t == "Int" || t == "Float" || t == "Bool" || t == "Void" { ret code }
  if t == "Ident" {
    let n = node["name"]
    if n == "true" || n == "false" { ret code }
    if _variant_arity(ctx, n) == 0 { ret "A_T(" + code + ")" }
    ret code
  }
  if t == "UnaryOp" && node["op"] != "!" && node["op"] != "-" { ret _tmp(node["expr"], code, ctx) }
  ret "A_T(" + code + ")"
}

; Wraps a statement's C code so temporaries it registered die with it.
fn _tmp_scope(ind: str, code: str) -> str {
  ret ind + "\{ int __tm = a_tmp_sp;\n" + code + "\n" + ind + "a_tmp_release(__tm); \}"
}

; Detects `name = <builtin>(name, ...)` for the accumulate builtins that have
; a consuming (`_move`) runtime variant. Returns the builtin name or "".
fn _self_update_builtin(assign, name: str) -> str {
  let v = assign["value"]
  if type_of(v) != "map" || v["tag"] != "Call" { ret "" }
  let f = v["func"]
  if type_of(f) != "map" { ret "" }
  let fname = _resolve_call_name(f)
  let args = v["args"]
  if fname == "push" {
    if len(args) != 2 { ret "" }
  } else if fname == "map.set" {
    if len(args) != 3 { ret "" }
  } else {
    ret ""
  }
  let a0 = args[0]
  if type_of(a0) == "map" && a0["tag"] == "Ident" && a0["name"] == name { ret fname }
  ret ""
}

fn _is_ident(node) -> bool {
  if type_of(node) != "map" { ret false }
  if node["tag"] != "Ident" { ret false }
  let n = node["name"]
  if n == "true" { ret false }
  if n == "false" { ret false }
  ret true
}

fn _emit_cleanup(vars, depth) -> str {
  let ind = _indent(depth)
  let mut out = ""
  for v in vars {
    out = str.concat(out, str.concat("\n", str.concat(ind, str.concat("a_release(", str.concat(v, ");")))))
  }
  ret out
}

; Cleanup for leaving a function or lambda body: release its variables and
; every temporary registered since it was entered (__tm0).
fn _emit_exit_cleanup(vars, depth) -> str {
  ret _emit_cleanup(vars, depth) + "\n" + _indent(depth) + "a_tmp_release(__tm0);"
}

; --- Escape analysis ---
; A variable escapes if its value can outlive its scope:
;   - returned from the function
;   - captured by a lambda
;   - stored in a collection passed to a non-builtin function

fn _ea_collect_idents(expr) -> [str] {
  if type_of(expr) != "map" { ret [] }
  let tag = expr["tag"]
  if tag == "Ident" {
    let n = expr["name"]
    if n == "true" { ret [] }
    if n == "false" { ret [] }
    ret [n]
  }
  if tag == "BinOp" { ret concat_arr(_ea_collect_idents(expr["left"]), _ea_collect_idents(expr["right"])) }
  if tag == "UnaryOp" { ret _ea_collect_idents(expr["expr"]) }
  if tag == "Call" {
    let mut ids = _ea_collect_idents(expr["func"])
    for a in expr["args"] { ids = concat_arr(ids, _ea_collect_idents(a)) }
    ret ids
  }
  if tag == "Index" { ret concat_arr(_ea_collect_idents(expr["expr"]), _ea_collect_idents(expr["index"])) }
  if tag == "FieldAccess" { ret _ea_collect_idents(expr["expr"]) }
  if tag == "Array" {
    let mut ids = []
    for e in expr["elems"] { ids = concat_arr(ids, _ea_collect_idents(e)) }
    ret ids
  }
  if tag == "MapLiteral" {
    let mut ids = []
    for e in expr["entries"] { ids = concat_arr(ids, _ea_collect_idents(e["value"])) }
    ret ids
  }
  if tag == "Spread" { ret _ea_collect_idents(expr["expr"]) }
  if tag == "Pipe" { ret concat_arr(_ea_collect_idents(expr["left"]), _ea_collect_idents(expr["right"])) }
  if tag == "Interpolation" {
    let mut ids = []
    for p in expr["parts"] {
      if p["tag"] != "InterpLit" { ids = concat_arr(ids, _ea_collect_idents(p["expr"])) }
    }
    ret ids
  }
  ret []
}

fn _escape_analysis(stmts, captures) -> [str] {
  let mut escaping = []

  for s in stmts {
    let tag = s["tag"]
    if tag == "Return" {
      if type_of(s["expr"]) != "void" {
        let ids = _ea_collect_idents(s["expr"])
        for id in ids {
          if !contains(escaping, id) { escaping = push(escaping, id) }
        }
      }
    }
  }

  ; Variables captured by lambdas escape
  for cap in captures {
    if !contains(escaping, cap) { escaping = push(escaping, cap) }
  }

  ret escaping
}

; --- Free variable analysis for closures ---

fn _collect_idents_in_expr(node) -> [str] {
  let tag = node["tag"]
  if type_of(tag) != "str" { ret [] }

  if tag == "Ident" { ret [node["name"]] }
  if tag == "Int" { ret [] }
  if tag == "Float" { ret [] }
  if tag == "Bool" { ret [] }
  if tag == "Void" { ret [] }
  if tag == "String" { ret [] }

  if tag == "BinOp" {
    ret concat_arr(_collect_idents_in_expr(node["left"]), _collect_idents_in_expr(node["right"]))
  }
  if tag == "UnaryOp" { ret _collect_idents_in_expr(node["expr"]) }

  if tag == "Call" {
    let mut ids = []
    let func = node["func"]
    if func["tag"] == "Ident" {
      ; function name idents are NOT variable captures
    } else {
      ids = concat_arr(ids, _collect_idents_in_expr(func))
    }
    for arg in node["args"] { ids = concat_arr(ids, _collect_idents_in_expr(arg)) }
    ret ids
  }

  if tag == "FieldAccess" { ret _collect_idents_in_expr(node["expr"]) }
  if tag == "Index" {
    ret concat_arr(_collect_idents_in_expr(node["expr"]), _collect_idents_in_expr(node["index"]))
  }

  if tag == "Array" {
    let mut ids = []
    for e in node["elems"] { ids = concat_arr(ids, _collect_idents_in_expr(e)) }
    ret ids
  }

  if tag == "MapLiteral" {
    let mut ids = []
    for e in node["entries"] { ids = concat_arr(ids, _collect_idents_in_expr(e["value"])) }
    ret ids
  }

  if tag == "Interpolation" {
    let mut ids = []
    for p in node["parts"] {
      if p["tag"] != "InterpLit" { ids = concat_arr(ids, _collect_idents_in_expr(p["expr"])) }
    }
    ret ids
  }

  if tag == "IfExpr" {
    ret concat_arr(_collect_idents_in_expr(node["cond"]),
      concat_arr(_collect_idents_in_expr(node["then"]), _collect_idents_in_expr(node["else"])))
  }

  if tag == "Pipe" {
    ret concat_arr(_collect_idents_in_expr(node["left"]), _collect_idents_in_expr(node["right"]))
  }

  if tag == "MatchExpr" {
    let mut ids = _collect_idents_in_expr(node["expr"])
    for arm in node["arms"] {
      if type_of(arm["guard"]) != "void" && arm["guard"]["tag"] != "Void" {
        ids = concat_arr(ids, _collect_idents_in_expr(arm["guard"]))
      }
      let body = arm["body"]
      if type_of(body["stmts"]) == "array" {
        ids = concat_arr(ids, _collect_idents_in_block(body))
      } else {
        ids = concat_arr(ids, _collect_idents_in_expr(body))
      }
    }
    ret ids
  }

  if tag == "Lambda" {
    ; lambdas capture, so we need to look inside but exclude lambda params
    let mut bound = []
    for p in node["params"] { bound = push(bound, p["name"]) }
    let body_ids = _collect_idents_in_block(node["body"])
    let mut free = []
    for id in body_ids {
      if !contains(bound, id) { if !contains(free, id) { free = push(free, id) } }
    }
    ret free
  }

  ret []
}

fn _collect_idents_in_block(block) -> [str] {
  if type_of(block["tag"]) == "str" {
    if block["tag"] == "BlockExpr" {
      ret _collect_idents_in_block(block["block"])
    }
  }
  let mut ids = []
  let stmts = block["stmts"]
  if type_of(stmts) != "array" { ret _collect_idents_in_expr(block) }
  for s in stmts { ids = concat_arr(ids, _collect_idents_in_stmt(s)) }
  ret ids
}

fn _collect_idents_in_stmt(s) -> [str] {
  let tag = s["tag"]
  if tag == "Let" { ret _collect_idents_in_expr(s["value"]) }
  if tag == "Assign" {
    ret concat_arr(_collect_idents_in_expr(s["target"]), _collect_idents_in_expr(s["value"]))
  }
  if tag == "Return" {
    if type_of(s["expr"]) != "void" { ret _collect_idents_in_expr(s["expr"]) }
    ret []
  }
  if tag == "ExprStmt" { ret _collect_idents_in_expr(s["expr"]) }
  if tag == "If" {
    let mut ids = _collect_idents_in_expr(s["cond"])
    ids = concat_arr(ids, _collect_idents_in_block(s["then"]))
    let eb = s["else"]
    if type_of(eb) != "void" {
      if eb["tag"] == "ElseBlock" { ids = concat_arr(ids, _collect_idents_in_block(eb["block"])) }
      if eb["tag"] == "ElseIf" { ids = concat_arr(ids, _collect_idents_in_stmt(eb["stmt"])) }
    }
    ret ids
  }
  if tag == "While" {
    ret concat_arr(_collect_idents_in_expr(s["cond"]), _collect_idents_in_block(s["body"]))
  }
  if tag == "For" {
    ret concat_arr(_collect_idents_in_expr(s["iter"]), _collect_idents_in_block(s["body"]))
  }
  ret []
}

; Returns ctx with `names` added to the variables a lambda may capture.
fn _with_enclosing(ctx, names: [str]) -> map {
  let mut enc = []
  if type_of(ctx["enclosing_vars"]) == "array" { enc = ctx["enclosing_vars"] }
  for n in names {
    if n != "" && n != "_" && !contains(enc, n) { enc = push(enc, n) }
  }
  ret map.set(ctx, "enclosing_vars", enc)
}

fn _compute_captures(lambda_node, enclosing_vars, bm) -> [str] {
  let mut bound = []
  for p in lambda_node["params"] { bound = push(bound, p["name"]) }
  let body = lambda_node["body"]
  let body_lets = _collect_lets_in_block(body)
  bound = concat_arr(bound, body_lets)

  let body_ids = _collect_idents_in_block(body)
  let mut captures = []
  for id in body_ids {
    if !contains(bound, id) && !map.has(bm, id) && contains(enclosing_vars, id) {
      if !contains(captures, id) { captures = push(captures, id) }
    }
  }
  ret captures
}

fn _collect_lets_in_block(block) -> [str] {
  if type_of(block["tag"]) == "str" {
    if block["tag"] == "BlockExpr" { ret _collect_lets_in_block(block["block"]) }
  }
  let mut names = []
  let stmts = block["stmts"]
  if type_of(stmts) != "array" { ret [] }
  for s in stmts {
    if s["tag"] == "Let" { names = push(names, s["name"]) }
  }
  ret names
}

; --- Expression emission ---
; Returns [code, li, [lifted_fns]]

fn emit_expr(node, bm, ctx, li) {
  let tag = node["tag"]

  if tag == "Int" { ret _R(str.concat("a_int(", str.concat(to_str(node["value"]), ")")), li) }
  if tag == "Float" { ret _R(str.concat("a_float(", str.concat(to_str(node["value"]), ")")), li) }
  if tag == "Bool" {
    if node["value"] { ret _R("a_bool(1)", li) }
    ret _R("a_bool(0)", li)
  }
  if tag == "Void" { ret _R("a_void()", li) }

  if tag == "String" {
    ret _R(str.concat("a_string(\"", str.concat(_escape_c_str(node["value"]), "\")")), li)
  }

  if tag == "Ident" {
    let name = node["name"]
    if name == "true" { ret _R("a_bool(1)", li) }
    if name == "false" { ret _R("a_bool(0)", li) }
    if _variant_arity(ctx, name) == 0 { ret _R("a_variant_new(\"" + name + "\", 0)", li) }
    ret _R(_mangle(name), li)
  }

  if tag == "BinOp" {
    let op = node["op"]
    let lr = emit_expr(node["left"], bm, ctx, li)
    let rr = emit_expr(node["right"], bm, ctx, lr[1])
    let l = _tmp(node["left"], lr[0], ctx)
    let r = _tmp(node["right"], rr[0], ctx)
    li = rr[1]
    let lifted = concat_arr(lr[2], rr[2])
    let mut code = ""
    if op == "+" { code = str.concat("a_add(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "-" && code == "" { code = str.concat("a_sub(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "*" && code == "" { code = str.concat("a_mul(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "/" && code == "" { code = str.concat("a_div(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "%" && code == "" { code = str.concat("a_mod(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "==" && code == "" { code = str.concat("a_eq(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "!=" && code == "" { code = str.concat("a_neq(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "<" && code == "" { code = str.concat("a_lt(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == ">" && code == "" { code = str.concat("a_gt(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "<=" && code == "" { code = str.concat("a_lteq(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == ">=" && code == "" { code = str.concat("a_gteq(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "&&" && code == "" { code = str.concat("a_and(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if op == "||" && code == "" { code = str.concat("a_or(", str.concat(l, str.concat(", ", str.concat(r, ")")))) }
    if code == "" { code = str.concat("/* unknown op: ", str.concat(op, " */a_void()")) }
    ret _RL(code, li, lifted)
  }

  if tag == "UnaryOp" {
    let ir = emit_expr(node["expr"], bm, ctx, li)
    let inner = _tmp(node["expr"], ir[0], ctx)
    if node["op"] == "!" { ret _RL("a_not(" + inner + ")", ir[1], ir[2]) }
    if node["op"] == "-" { ret _RL("a_neg(" + inner + ")", ir[1], ir[2]) }
    ret ir
  }

  if tag == "Call" {
    let func = node["func"]
    let a = node["args"]
    let fname = _resolve_call_name(func)

    if fname == "__unknown__" {
      let dotted = _dotted_path(func)
      if len(dotted) > 0 {
        let short = _last_two_segments(dotted)
        _compile_error(node, ctx, "cannot call " + dotted + ": a module is referenced by its last segment, e.g. " + short)
      }
      ; Any other callee is an expression producing a closure: arr[0](x), m["f"](x), f()(x)
      let fr = emit_expr(func, bm, ctx, li)
      let mut li2 = fr[1]
      let mut lifted2 = fr[2]
      let mut call_args = [to_str(len(a))]
      for arg in a {
        let ar = emit_expr(arg, bm, ctx, li2)
        call_args = push(call_args, _tmp(arg, ar[0], ctx))
        li2 = ar[1]
        lifted2 = concat_arr(lifted2, ar[2])
      }
      ret _RL("a_closure_call(" + _tmp(func, fr[0], ctx) + ", " + str.join(call_args, ", ") + ")", li2, lifted2)
    }

    if fname == "fail" {
      if len(a) > 0 {
        let ar = emit_expr(a[0], bm, ctx, li)
        ret _RL("(a_fail(" + _tmp(a[0], ar[0], ctx) + "), a_void())", ar[1], ar[2])
      }
      ret _R("(a_fail(a_string(\"assertion failed\")), a_void())", li)
    }
    if fname == "exit" {
      if len(a) > 0 {
        let ar = emit_expr(a[0], bm, ctx, li)
        ret _RL(str.concat("(exit((int)", str.concat(ar[0], ".ival), a_void())")), ar[1], ar[2])
      }
      ret _R("(exit(0), a_void())", li)
    }

    ; Emit args
    let mut arg_codes = []
    let mut lifted = []
    for arg in a {
      let ar = emit_expr(arg, bm, ctx, li)
      arg_codes = push(arg_codes, _tmp(arg, ar[0], ctx))
      li = ar[1]
      lifted = concat_arr(lifted, ar[2])
    }

    if map.has(bm, fname) {
      let cfn = bm[fname]
      let mins = _builtin_min_arity()
      if map.has(mins, fname) && len(arg_codes) >= mins[fname] {
        let full = _builtin_full_arity(fname)
        while len(arg_codes) < full { arg_codes = push(arg_codes, "a_void()") }
      }
      ret _RL(str.concat(cfn, str.concat("(", str.concat(str.join(arg_codes, ", "), ")"))), li, lifted)
    }

    let var_arity = _variant_arity(ctx, fname)
    if var_arity >= 0 {
      if var_arity != len(arg_codes) {
        _compile_error(node, ctx, fname + " takes " + to_str(var_arity) + " argument(s), got " + to_str(len(arg_codes)))
      }
      let mut vargs = ["\"" + fname + "\"", to_str(len(arg_codes))]
      vargs = concat_arr(vargs, arg_codes)
      ret _RL("a_variant_new(" + str.join(vargs, ", ") + ")", li, lifted)
    }

    ; Check if this is a closure call (variable, not a known function)
    let all_fns = ctx["fns"]
    let is_known_fn = false
    if type_of(all_fns) == "array" { is_known_fn = contains(all_fns, fname) }
    if str.contains(fname, ".") { is_known_fn = true }

    if func["tag"] == "Ident" && !is_known_fn && !_is_intra_module_call(fname, ctx) {
      ; Closure call: a_closure_call(var, argc, arg1, arg2, ...)
      let mut call_args = [to_str(len(arg_codes))]
      call_args = concat_arr(call_args, arg_codes)
      ret _RL(str.concat("a_closure_call(", str.concat(_mangle(fname), str.concat(", ", str.concat(str.join(call_args, ", "), ")")))), li, lifted)
    }

    let mut mangled = ""
    let aliases = ctx["import_aliases"]
    if type_of(aliases) == "map" && map.has(aliases, fname) {
      mangled = str.concat("fn_", _mangle(aliases[fname]))
    } else if _is_intra_module_call(fname, ctx) {
      mangled = str.concat("fn_", _mangle(_prefixed_name(fname, ctx)))
    } else {
      mangled = str.concat("fn_", _mangle(fname))
    }
    ret _RL(str.concat(mangled, str.concat("(", str.concat(str.join(arg_codes, ", "), ")"))), li, lifted)
  }

  if tag == "FieldAccess" {
    let er = emit_expr(node["expr"], bm, ctx, li)
    let field = node["field"]
    ret _RL("a_map_get_cstr(" + _tmp(node["expr"], er[0], ctx) + ", \"" + _escape_c_str(field) + "\")", er[1], er[2])
  }

  if tag == "Index" {
    let er = emit_expr(node["expr"], bm, ctx, li)
    let ir = emit_expr(node["index"], bm, ctx, er[1])
    let base = _tmp(node["expr"], er[0], ctx)
    ; `m["key"]` on a map is the overwhelmingly common case: skip allocating the key
    if node["index"]["tag"] == "String" {
      ret _RL("a_index_cstr(" + base + ", \"" + _escape_c_str(node["index"]["value"]) + "\")", ir[1], concat_arr(er[2], ir[2]))
    }
    ret _RL("a_array_get(" + base + ", " + _tmp(node["index"], ir[0], ctx) + ")", ir[1], concat_arr(er[2], ir[2]))
  }

  if tag == "Array" {
    let elems = node["elems"]
    if len(elems) == 0 { ret _R("a_array_new(0)", li) }

    ; Check for spread elements
    let mut has_spread = false
    for e in elems { if e["tag"] == "Spread" { has_spread = true } }

    let mut lifted = []
    if has_spread {
      ; Build incrementally: start empty, push or concat
      ; Build incrementally; each intermediate array is a temporary of this statement.
      let mut code = "a_array_new(0)"
      for e in elems {
        if e["tag"] == "Spread" {
          let er = emit_expr(e["expr"], bm, ctx, li)
          li = er[1]
          lifted = concat_arr(lifted, er[2])
          code = "a_concat_arr(A_T(" + code + "), " + _tmp(e["expr"], er[0], ctx) + ")"
        } else {
          let er = emit_expr(e, bm, ctx, li)
          li = er[1]
          lifted = concat_arr(lifted, er[2])
          code = "a_array_push(A_T(" + code + "), " + _tmp(e, er[0], ctx) + ")"
        }
      }
      ret _RL(code, li, lifted)
    }

    let mut parts = []
    for e in elems {
      let er = emit_expr(e, bm, ctx, li)
      parts = push(parts, _tmp(e, er[0], ctx))
      li = er[1]
      lifted = concat_arr(lifted, er[2])
    }
    ret _RL(str.concat("a_array_new(", str.concat(to_str(len(elems)), str.concat(", ", str.concat(str.join(parts, ", "), ")")))), li, lifted)
  }

  if tag == "MapLiteral" {
    let entries = node["entries"]
    if len(entries) == 0 { ret _R("a_map_new(0)", li) }
    let mut parts = []
    let mut lifted = []
    for e in entries {
      let key_node = e["key"]
      let key_str = ""
      if key_node["tag"] == "String" { key_str = key_node["value"] }
      let vr = emit_expr(e["value"], bm, ctx, li)
      li = vr[1]
      lifted = concat_arr(lifted, vr[2])
      parts = push(parts, "\"" + _escape_c_str(key_str) + "\", " + _tmp(e["value"], vr[0], ctx))
    }
    ret _RL(str.concat("a_map_new(", str.concat(to_str(len(entries)), str.concat(", ", str.concat(str.join(parts, ", "), ")")))), li, lifted)
  }

  if tag == "Interpolation" {
    let parts = node["parts"]
    let mut cparts = []
    let mut lifted = []
    for p in parts {
      if p["tag"] == "InterpLit" {
        cparts = push(cparts, "A_T(a_string(\"" + _escape_c_str(p["value"]) + "\"))")
      } else {
        let er = emit_expr(p["expr"], bm, ctx, li)
        li = er[1]
        lifted = concat_arr(lifted, er[2])
        cparts = push(cparts, "A_T(a_to_str(" + _tmp(p["expr"], er[0], ctx) + "))")
      }
    }
    ret _RL(str.concat("a_concat_n(", str.concat(to_str(len(cparts)), str.concat(", ", str.concat(str.join(cparts, ", "), ")")))), li, lifted)
  }

  if tag == "IfExpr" {
    let cr = emit_expr(node["cond"], bm, ctx, li)
    let tr = emit_expr(node["then"], bm, ctx, cr[1])
    let er = emit_expr(node["else"], bm, ctx, tr[1])
    let lifted = concat_arr(cr[2], concat_arr(tr[2], er[2]))
    ; both branches must yield owned values: retain when a branch is a variable
    let mut t = tr[0]
    if _is_ident(node["then"]) { t = "a_retain(" + t + ")" }
    let mut e = er[0]
    if _is_ident(node["else"]) { e = "a_retain(" + e + ")" }
    ret _RL("(a_truthy(" + _tmp(node["cond"], cr[0], ctx) + ") ? " + t + " : " + e + ")", er[1], lifted)
  }

  if tag == "MatchExpr" {
    ret _emit_match_expr(node, bm, ctx, li)
  }

  if tag == "BlockExpr" {
    let stmts = node["block"]["stmts"]
    if len(stmts) > 0 {
      let last = stmts[len(stmts) - 1]
      if last["tag"] == "ExprStmt" {
        ret emit_expr(last["expr"], bm, ctx, li)
      }
      if last["tag"] == "Return" {
        if type_of(last["expr"]) != "void" {
          ret emit_expr(last["expr"], bm, ctx, li)
        }
      }
    }
    ret _R("a_void()", li)
  }

  ; --- Pipe: desugar to function call ---
  if tag == "Pipe" {
    let right = node["right"]
    if right["tag"] == "Call" {
      let new_args = concat_arr([node["left"]], right["args"])
      let new_call = #{"tag": "Call", "func": right["func"], "args": new_args}
      ret emit_expr(new_call, bm, ctx, li)
    }
    ; Pipe to a non-call: treat as closure call with one arg
    let lr = emit_expr(node["left"], bm, ctx, li)
    let rr = emit_expr(node["right"], bm, ctx, lr[1])
    let lifted = concat_arr(lr[2], rr[2])
    ret _RL("a_closure_call(" + _tmp(node["right"], rr[0], ctx) + ", 1, " + _tmp(node["left"], lr[0], ctx) + ")", rr[1], lifted)
  }

  ; --- Lambda: lift to top-level function, emit closure creation ---
  if tag == "Lambda" {
    let lambda_name = _lambda_name(ctx, li)
    let params = node["params"]
    let body = node["body"]

    ; Determine captures
    let enclosing_vars = ctx["enclosing_vars"]
    let mut captures = []
    if type_of(enclosing_vars) == "array" {
      captures = _compute_captures(node, enclosing_vars, bm)
    }

    ; Build lifted function body
    let mut fn_code = str.concat("static AValue ", str.concat(lambda_name, "(AValue __env, int __argc, AValue* __argv) \{"))

    ; Load captures from env
    let mut ci = 0
    for cap in captures {
      fn_code = str.concat(fn_code, str.concat("\n    AValue ", str.concat(_mangle(cap), str.concat(" = a_array_get(__env, a_int(", str.concat(to_str(ci), "));")))))
      ci = ci + 1
    }

    ; Load params from argv
    let mut pi = 0
    for p in params {
      ; A caller may pass fewer arguments than the lambda declares (e.g. a
      ; 2-arg comparator handed to a 1-arg key function). Missing ones are void.
      ; Params are owned like every other named variable (released in the
      ; cleanup below), so assigning to one, or pushing onto one in place, is safe.
      fn_code = fn_code + "\n    AValue " + _mangle(p["name"]) + " = __argc > " + to_str(pi) + " ? a_retain(__argv[" + to_str(pi) + "]) : a_void();"
      pi = pi + 1
    }

    let mut frame_name = "<lambda>"
    if map.has(ctx, "fn_name") { frame_name = "<lambda in " + ctx["fn_name"] + ">" }
    fn_code = fn_code + "\n    A_FRAME(" + _c_str(frame_name) + ", " + _c_str(_ctx_file(ctx)) + ");"
    fn_code = fn_code + "\n    int __tm0 = a_tmp_sp;"
    ; an expression body has no statements to record a line; use the lambda's own
    fn_code = fn_code + _line_stmt(node, 1)

    let next_li = li + 1
    let mut body_lifted = []

    ; Build lambda ctx with its own enclosing vars for nested lambdas
    let mut lambda_vars = []
    for cap in captures { lambda_vars = push(lambda_vars, cap) }
    for p in params { lambda_vars = push(lambda_vars, p["name"]) }

    ; Unwrap body: BlockExpr wraps a block, or body is an expression
    let body_tag = body["tag"]
    if body_tag == "BlockExpr" {
      let stmts = body["block"]["stmts"]

      ; Pre-declare body locals
      let body_vars = _collect_vars_in_stmts(stmts)
      let mut bound = []
      for cap in captures { bound = push(bound, _mangle(cap)) }
      for p in params { bound = push(bound, _mangle(p["name"])) }
      let mut decl_vars = []
      for v in body_vars {
        if !contains(bound, v) { if !contains(decl_vars, v) { decl_vars = push(decl_vars, v) } }
      }
      ; Add body-scoped lets to lambda_vars for nested lambda capture analysis
      let body_lets = _collect_lets_in_block(body["block"])
      for bl in body_lets { lambda_vars = push(lambda_vars, bl) }
      let lambda_ctx = map.set(ctx, "enclosing_vars", lambda_vars)

      if len(decl_vars) > 0 {
        let mut init_parts = []
        for v in decl_vars { init_parts = push(init_parts, str.concat(v, " = \{0\}")) }
        fn_code = str.concat(fn_code, str.concat("\n    AValue ", str.concat(str.join(init_parts, ", "), ";")))
      }

      let mut lambda_cleanup = []
      for cap in captures { lambda_cleanup = push(lambda_cleanup, _mangle(cap)) }
      for p in params { lambda_cleanup = push(lambda_cleanup, _mangle(p["name"])) }
      lambda_cleanup = concat_arr(lambda_cleanup, decl_vars)
      lambda_ctx = map.set(lambda_ctx, "cleanup_vars", lambda_cleanup)
      lambda_ctx = map.set(lambda_ctx, "goto_cleanup", false)

      ; Emit body, making the last ExprStmt an implicit return
      let mut has_return = false
      let mut si = 0
      while si < len(stmts) {
        let s = stmts[si]
        let is_last = si == len(stmts) - 1
        if is_last && s["tag"] == "ExprStmt" {
          fn_code = fn_code + _line_stmt(s, 1)
          let er = emit_expr(s["expr"], bm, lambda_ctx, next_li)
          let cleanup = _emit_exit_cleanup(lambda_cleanup, 1)
          ; The returned value must be owned by the caller; a bare variable is
          ; about to be released by the cleanup, so hand out a fresh reference.
          let mut ret_expr = er[0]
          if _is_ident(s["expr"]) { ret_expr = "a_retain(" + ret_expr + ")" }
          fn_code = str.concat(fn_code, str.concat("\n    \{ AValue __ret = ", str.concat(ret_expr, str.concat(";", str.concat(cleanup, "\n    return __ret; \}")))))
          next_li = er[1]
          body_lifted = concat_arr(body_lifted, er[2])
          has_return = true
        } else {
          let sr = emit_stmt(s, 1, bm, lambda_ctx, next_li)
          fn_code = str.concat(fn_code, str.concat("\n", sr[0]))
          next_li = sr[1]
          body_lifted = concat_arr(body_lifted, sr[2])
          if is_last && s["tag"] == "Return" { has_return = true }
        }
        si = si + 1
      }
      if !has_return {
        let cleanup = _emit_exit_cleanup(lambda_cleanup, 1)
        fn_code = str.concat(fn_code, str.concat(cleanup, "\n    return a_void();"))
      }
    } else {
      ; Expression-body lambda: fn(x) => expr
      let lambda_ctx = map.set(ctx, "enclosing_vars", lambda_vars)
      let mut lambda_cleanup = []
      for cap in captures { lambda_cleanup = push(lambda_cleanup, _mangle(cap)) }
      for p in params { lambda_cleanup = push(lambda_cleanup, _mangle(p["name"])) }
      lambda_ctx = map.set(lambda_ctx, "cleanup_vars", lambda_cleanup)
      lambda_ctx = map.set(lambda_ctx, "goto_cleanup", false)
      let er = emit_expr(body, bm, lambda_ctx, next_li)
      let cleanup = _emit_exit_cleanup(lambda_cleanup, 1)
      let mut ret_expr = er[0]
      if _is_ident(body) { ret_expr = "a_retain(" + ret_expr + ")" }
      fn_code = str.concat(fn_code, str.concat("\n    \{ AValue __ret = ", str.concat(ret_expr, str.concat(";", str.concat(cleanup, "\n    return __ret; \}")))))
      next_li = er[1]
      body_lifted = concat_arr(body_lifted, er[2])
    }
    fn_code = str.concat(fn_code, "\n\}\n")

    ; Emit closure creation at the expression site
    ; a_array_new retains the captured values and a_closure retains the env
    ; array, so the array itself is a temporary of this statement.
    let mut env_code = "a_void()"
    if len(captures) > 0 {
      let mut cap_parts = []
      for cap in captures { cap_parts = push(cap_parts, _mangle(cap)) }
      env_code = "A_T(a_array_new(" + to_str(len(captures)) + ", " + str.join(cap_parts, ", ") + "))"
    }
    let closure_code = str.concat("a_closure(", str.concat(lambda_name, str.concat(", ", str.concat(env_code, ")"))))

    let all_lifted = concat_arr(body_lifted, [fn_code])
    ret _RL(closure_code, next_li, all_lifted)
  }

  ; --- Try: expr? or try expr ---
  ; --- expr? : Ok(v) yields v; Err returns the Err from the enclosing
  ; function (inside a `try { }` block it is caught there instead).
  if tag == "Try" {
    let er = emit_expr(node["expr"], bm, ctx, li)
    let use_goto = type_of(ctx["goto_cleanup"]) == "bool" && ctx["goto_cleanup"]
    let cleanup_vars = ctx["cleanup_vars"]
    let mut on_err = "return __t;"
    if use_goto {
      on_err = "__ret = __t; goto __fn_cleanup;"
    } else if type_of(cleanup_vars) == "array" && len(cleanup_vars) > 0 {
      on_err = "\{" + _emit_exit_cleanup(cleanup_vars, 0) + " return __t; \}"
    }
    ; __t is released below (or handed out as the function's Err), so it must be
    ; an owned reference: `r?` on a variable takes a fresh one.
    let mut src = er[0]
    if _is_ident(node["expr"]) { src = "a_retain(" + src + ")" }
    let code = "(\{ AValue __t = " + src + "; if (a_is_err_raw(__t)) \{ if (a_try_depth > 0) a_try_raise(__t); " + on_err + " \} AValue __v = a_unwrap(__t); a_release(__t); __v; \})"
    ret _RL(code, er[1], er[2])
  }

  ; --- TryBlock: try { block } ---
  if tag == "TryBlock" {
    ; TryBlock is an expression that returns a Result.
    ; We use setjmp/longjmp via the runtime try stack.
    ; This produces a statement-expression using GCC ({...}) extension,
    ; but for portability we use a temp variable approach.
    ; The caller wraps this in an assignment: result = <try_block_code>;
    ; We emit a helper: a block that sets __try_result, then use __try_result as the value.
    ; However, since this is an expression context, we need a GCC statement-expression.
    let block = node["block"]
    let stmts = block["stmts"]
    let nl = _newline_char()
    let mut code = str.concat("(\{", nl)
    code = str.concat(code, str.concat("        AValue __try_result;", nl))
    ; Pre-declare variables used inside the try block
    let try_vars = _collect_vars_in_stmts(stmts)
    if len(try_vars) > 0 {
      let mut tv_parts = []
      for v in try_vars { tv_parts = push(tv_parts, v + " = \{0\}") }
      code = code + "        AValue " + str.join(tv_parts, ", ") + ";" + nl
    }
    code = str.concat(code, str.concat("        int __try_frames = a_frame_depth;", nl))
    code = code + "        int __try_tm = a_tmp_sp;" + nl
    code = str.concat(code, str.concat("        a_try_depth++;", nl))
    code = str.concat(code, str.concat("        if (setjmp(a_try_stack[a_try_depth - 1]) == 0) \{", nl))

    let mut lifted = []
    let nstmts = len(stmts)
    let has_tail = nstmts > 0 && stmts[nstmts - 1]["tag"] == "ExprStmt"
    if has_tail {
      code = str.concat(code, str.concat("        AValue __try_tail = a_void();", nl))
    }
    let mut si = 0
    while si < nstmts {
      let s = stmts[si]
      let is_last = si == nstmts - 1
      if is_last && has_tail {
        let er = emit_expr(s["expr"], bm, ctx, li)
        ; a_ok retains the tail, so an owned tail is a temporary of this statement
        code = code + "            __try_tail = " + _tmp(s["expr"], er[0], ctx) + ";" + nl
        li = er[1]
        lifted = concat_arr(lifted, er[2])
      } else {
        let sr = emit_stmt(s, 3, bm, ctx, li)
        code = str.concat(code, str.concat(sr[0], nl))
        li = sr[1]
        lifted = concat_arr(lifted, sr[2])
      }
      si = si + 1
    }

    code = str.concat(code, str.concat("            a_try_depth--;", nl))
    if has_tail {
      code = str.concat(code, str.concat("            __try_result = a_ok(__try_tail);", nl))
    } else {
      code = str.concat(code, str.concat("            __try_result = a_ok(a_void());", nl))
    }
    ; a_ok retained the tail; A_T temps from the success path die here
    code = code + "            a_tmp_release(__try_tm);" + nl
    code = str.concat(code, str.concat("        \} else \{", nl))
    code = str.concat(code, str.concat("            a_try_depth--;", nl))
    code = str.concat(code, str.concat("            A_UNWIND(__try_frames);", nl))
    ; the payload is owned by a_try_err; temporaries registered by the
    ; statements longjmp skipped are released once the Err holds it
    code = str.concat(code, str.concat("            __try_result = a_err(a_try_err);", nl))
    code = code + "            a_release(a_try_err); a_try_err = a_void();" + nl
    code = code + "            a_tmp_release(__try_tm);" + nl
    code = str.concat(code, str.concat("        \}", nl))
    for v in try_vars { code = code + "        a_release(" + v + ");" + nl }
    code = str.concat(code, str.concat("        __try_result;", nl))
    code = str.concat(code, "    \})")

    ret _RL(code, li, lifted)
  }

  ret _R(str.concat("/* unhandled expr: ", str.concat(tag, " */a_void()")), li)
}

; "a.b.c" for a pure Ident/FieldAccess chain, "" otherwise.
fn _dotted_path(e) -> str {
  if type_of(e) != "map" { ret "" }
  if e["tag"] == "Ident" { ret e["name"] }
  if e["tag"] == "FieldAccess" {
    let base = _dotted_path(e["expr"])
    if len(base) == 0 { ret "" }
    ret base + "." + e["field"]
  }
  ret ""
}

fn _last_two_segments(dotted: str) -> str {
  let parts = str.split(dotted, ".")
  let n = len(parts)
  if n < 2 { ret dotted }
  ret parts[n - 2] + "." + parts[n - 1]
}

; Abort compilation with a gcc-style located error. Nodes produced by
; parse_stmt/parse_expr carry line/col; others fall back to the file alone.
fn _compile_error(node, ctx, msg: str) {
  let mut loc = ""
  if type_of(ctx) == "map" && map.has(ctx, "file") { loc = ctx["file"] }
  if type_of(node) == "map" && map.has(node, "line") && node["line"] > 0 {
    loc = loc + ":" + to_str(node["line"]) + ":" + to_str(node["col"])
  }
  if len(loc) == 0 { fail("error: " + msg) }
  fail(loc + ": error: " + msg)
}

fn _resolve_call_name(func) -> str {
  if func["tag"] == "Ident" { ret func["name"] }
  if func["tag"] == "FieldAccess" {
    let obj = func["expr"]
    if obj["tag"] == "Ident" {
      ret str.concat(obj["name"], str.concat(".", func["field"]))
    }
  }
  ret "__unknown__"
}

; --- Pattern matching emission ---
; _emit_pat_cond: returns [cond_code, li, lifted] where cond_code is a C boolean expr
; _emit_pat_bind: returns [bind_code, li, lifted] where bind_code is C statements

fn _emit_pat_cond(pat, target, bm, ctx, li) {
  let tag = pat["tag"]
  if tag == "PatWildcard" { ret _R("1", li) }
  if tag == "PatIdent" {
    ; a bare nullary constructor (`Empty => ...`) is a test, not a binding
    if _variant_arity(ctx, pat["name"]) == 0 { ret _R("a_is_variant(" + target + ", \"" + pat["name"] + "\")", li) }
    ret _R("1", li)
  }

  if tag == "PatLiteral" {
    let val = pat["value"]
    let vr = emit_expr(val, bm, ctx, li)
    ret _RL("a_truthy(a_eq(" + target + ", " + _tmp(val, vr[0], ctx) + "))", vr[1], vr[2])
  }

  if tag == "PatConstructor" {
    let name = pat["name"]
    let args = pat["args"]
    if name == "Ok" || name == "Err" {
      let mut cond = "a_is_err_raw(" + target + ")"
      if name == "Ok" { cond = "a_is_ok_raw(" + target + ")" }
      if len(args) > 0 && args[0]["tag"] != "PatIdent" && args[0]["tag"] != "PatWildcard" {
        let sc = _emit_pat_cond(args[0], "a_unwrap_unsafe(" + target + ")", bm, ctx, li)
        ret _RL(cond + " && " + sc[0], sc[1], sc[2])
      }
      ret _R(cond, li)
    }
    if _variant_arity(ctx, name) < 0 {
      _compile_error(pat, ctx, "unknown constructor " + name + " in pattern")
    }
    let mut cond = "a_is_variant(" + target + ", \"" + name + "\")"
    let mut lifted = []
    let mut i = 0
    for a in args {
      if a["tag"] != "PatIdent" && a["tag"] != "PatWildcard" {
        let sc = _emit_pat_cond(a, "a_variant_arg(" + target + ", " + to_str(i) + ")", bm, ctx, li)
        li = sc[1]
        lifted = concat_arr(lifted, sc[2])
        cond = cond + " && " + sc[0]
      }
      i = i + 1
    }
    ret _RL(cond, li, lifted)
  }

  if tag == "PatArray" {
    let elems = pat["elems"]
    let mut has_rest = false
    let mut fixed_count = 0
    for e in elems {
      if e["tag"] == "PatRest" { has_rest = true }
      if e["tag"] == "PatElem" { fixed_count = fixed_count + 1 }
    }
    let mut cond = ""
    if has_rest {
      cond = str.concat("a_is_array_min_len(", str.concat(target, str.concat(", ", str.concat(to_str(fixed_count), ")"))))
    } else {
      cond = str.concat("a_is_array_of_len(", str.concat(target, str.concat(", ", str.concat(to_str(fixed_count), ")"))))
    }
    ; Add nested element conditions
    let mut idx = 0
    let mut lifted = []
    for e in elems {
      if e["tag"] == "PatElem" {
        let sub = e["pattern"]
        if sub["tag"] != "PatIdent" && sub["tag"] != "PatWildcard" {
          let elem_var = str.concat(target, str.concat(".aval->items[", str.concat(to_str(idx), "]")))
          let sc = _emit_pat_cond(sub, elem_var, bm, ctx, li)
          li = sc[1]
          lifted = concat_arr(lifted, sc[2])
          cond = str.concat(cond, str.concat(" && ", sc[0]))
        }
        idx = idx + 1
      }
    }
    ret _RL(cond, li, lifted)
  }

  if tag == "PatMap" {
    let entries = pat["entries"]
    let mut cond = str.concat(target, ".tag == TAG_MAP")
    let mut lifted = []
    for e in entries {
      let key = e["key"]
      cond = str.concat(cond, str.concat(" && a_is_map_with(", str.concat(target, str.concat(", \"", str.concat(_escape_c_str(key), "\")")))))
      ; Add nested value conditions
      let sub = e["pattern"]
      if sub["tag"] != "PatIdent" && sub["tag"] != "PatWildcard" {
        let val_expr = "a_map_get_borrow(" + target + ", \"" + _escape_c_str(key) + "\")"
        let sc = _emit_pat_cond(sub, val_expr, bm, ctx, li)
        li = sc[1]
        lifted = concat_arr(lifted, sc[2])
        cond = str.concat(cond, str.concat(" && ", sc[0]))
      }
    }
    ret _RL(cond, li, lifted)
  }

  ret _R("0 /* unknown pattern */", li)
}

fn _emit_pat_bind(pat, target, depth, bm, ctx, li) {
  let tag = pat["tag"]
  let ind = _indent(depth)

  if tag == "PatWildcard" { ret _R("", li) }

  if tag == "PatIdent" {
    if _variant_arity(ctx, pat["name"]) == 0 { ret _R("", li) }
    ; Pattern targets are borrowed views into the matched value (result inner,
    ; array slot, map slot). The binding is a function-scoped local released in
    ; the cleanup epilogue, so it must own its reference.
    let v = _mangle(pat["name"])
    ret _R(ind + "\{ AValue __old = " + v + "; " + v + " = a_retain(" + target + "); a_release(__old); \}", li)
  }

  if tag == "PatLiteral" { ret _R("", li) }

  if tag == "PatConstructor" {
    let name = pat["name"]
    let args = pat["args"]
    let mut code = ""
    if (name == "Ok" || name == "Err") && len(args) > 0 {
      let inner = args[0]
      let inner_expr = str.concat("a_unwrap_unsafe(", str.concat(target, ")"))
      let br = _emit_pat_bind(inner, inner_expr, depth, bm, ctx, li)
      code = br[0]
      li = br[1]
      ret _R(code, li)
    }
    let mut i = 0
    for a in args {
      let br = _emit_pat_bind(a, "a_variant_arg(" + target + ", " + to_str(i) + ")", depth, bm, ctx, li)
      if len(br[0]) > 0 { code = code + br[0] + "\n" }
      li = br[1]
      i = i + 1
    }
    ret _R(code, li)
  }

  if tag == "PatArray" {
    let elems = pat["elems"]
    let mut code = ""
    let mut idx = 0
    let mut lifted = []
    for e in elems {
      if e["tag"] == "PatElem" {
        let elem_var = str.concat(target, str.concat(".aval->items[", str.concat(to_str(idx), "]")))
        let br = _emit_pat_bind(e["pattern"], elem_var, depth, bm, ctx, li)
        if len(br[0]) > 0 {
          if len(code) > 0 { code = str.concat(code, "\n") }
          code = str.concat(code, br[0])
        }
        li = br[1]
        lifted = concat_arr(lifted, br[2])
        idx = idx + 1
      }
      if e["tag"] == "PatRest" {
        ; a_drop returns a fresh owned array; release whatever the slot held before.
        let rest_expr = "a_drop(" + target + ", a_int(" + to_str(idx) + "))"
        let rv = _mangle(e["name"])
        if len(code) > 0 { code = str.concat(code, "\n") }
        code = code + ind + "\{ AValue __old = " + rv + "; " + rv + " = " + rest_expr + "; a_release(__old); \}"
      }
    }
    ret _RL(code, li, lifted)
  }

  if tag == "PatMap" {
    let entries = pat["entries"]
    let mut code = ""
    let mut lifted = []
    for e in entries {
      let key = e["key"]
      let val_expr = "a_map_get_borrow(" + target + ", \"" + _escape_c_str(key) + "\")"
      let br = _emit_pat_bind(e["pattern"], val_expr, depth, bm, ctx, li)
      if len(br[0]) > 0 {
        if len(code) > 0 { code = str.concat(code, "\n") }
        code = str.concat(code, br[0])
      }
      li = br[1]
      lifted = concat_arr(lifted, br[2])
    }
    ret _RL(code, li, lifted)
  }

  ret _R("", li)
}

fn _emit_arm_body(body, depth, bm, ctx, li) {
  let mut code = ""
  let mut lifted = []
  if type_of(body["stmts"]) == "array" {
    for s in body["stmts"] {
      let sr = emit_stmt(s, depth, bm, ctx, li)
      if len(code) > 0 { code = str.concat(code, "\n") }
      code = str.concat(code, sr[0])
      li = sr[1]
      lifted = concat_arr(lifted, sr[2])
    }
  } else {
    ; Single expression body -- emit as expression statement
    let er = emit_expr(body, bm, ctx, li)
    li = er[1]
    lifted = concat_arr(lifted, er[2])
    code = _indent(depth) + _tmp(body, er[0], ctx) + ";"
  }
  ret _RL(code, li, lifted)
}

fn _emit_match(node, depth, bm, ctx, li) {
  let ind = _indent(depth)
  let d1 = _indent(depth + 1)
  let d2 = _indent(depth + 2)
  let er = emit_expr(node["expr"], bm, ctx, li)
  li = er[1]
  let mut lifted = er[2]
  let arms = node["arms"]

  let mut out = str.concat(ind, "\{")
  out = out + "\n" + d1 + "AValue __match = " + _tmp(node["expr"], er[0], ctx) + ";"
  out = str.concat(out, str.concat("\n", str.concat(d1, "int __matched = 0;")))

  for arm in arms {
    let pat = arm["pattern"]
    let guard = arm["guard"]
    let body = arm["body"]

    let cr = _emit_pat_cond(pat, "__match", bm, ctx, li)
    li = cr[1]
    lifted = concat_arr(lifted, cr[2])

    let mut has_guard = type_of(guard) != "void"
    if has_guard { if guard["tag"] == "Void" { has_guard = false } }

    out = str.concat(out, str.concat("\n", str.concat(d1, str.concat("if (!__matched && ", str.concat(cr[0], ") \{")))))

    ; Emit bindings
    let br = _emit_pat_bind(pat, "__match", depth + 2, bm, ctx, li)
    li = br[1]
    lifted = concat_arr(lifted, br[2])
    if len(br[0]) > 0 {
      out = str.concat(out, str.concat("\n", br[0]))
    }

    if has_guard {
      let gr = emit_expr(guard, bm, ctx, li)
      li = gr[1]
      lifted = concat_arr(lifted, gr[2])
      out = out + "\n" + d2 + "if (a_truthy(" + _tmp(guard, gr[0], ctx) + ")) \{"

      let br2 = _emit_arm_body(body, depth + 3, bm, ctx, li)
      li = br2[1]
      lifted = concat_arr(lifted, br2[2])
      if len(br2[0]) > 0 { out = str.concat(out, str.concat("\n", br2[0])) }
      out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 3), "__matched = 1;")))

      out = str.concat(out, str.concat("\n", str.concat(d2, "\}")))
    } else {
      let br2 = _emit_arm_body(body, depth + 2, bm, ctx, li)
      li = br2[1]
      lifted = concat_arr(lifted, br2[2])
      if len(br2[0]) > 0 { out = str.concat(out, str.concat("\n", br2[0])) }
      out = str.concat(out, str.concat("\n", str.concat(d2, "__matched = 1;")))
    }

    out = str.concat(out, str.concat("\n", str.concat(d1, "\}")))
  }

  out = out + "\n" + d1 + "if (!__matched) a_fatal(\"runtime error: \", a_string(\"non-exhaustive match\"));"
  out = str.concat(out, str.concat("\n", str.concat(ind, "\}")))
  ret _RL(out, li, lifted)
}

fn _emit_match_expr(node, bm, ctx, li) {
  let nl = _newline_char()
  let er = emit_expr(node["expr"], bm, ctx, li)
  li = er[1]
  let mut lifted = er[2]
  let arms = node["arms"]

  let mut code = str.concat("(\{", nl)
  code = str.concat(code, str.concat("        AValue __match = ", str.concat(_tmp(node["expr"], er[0], ctx), str.concat(";", nl))))
  code = str.concat(code, str.concat("        AValue __match_result = a_void();", nl))
  code = str.concat(code, str.concat("        int __matched = 0;", nl))

  ; Pre-declare arm variables
  let mut arm_vars = []
  for arm in arms {
    let pv = _collect_pattern_vars(arm["pattern"])
    for v in pv { if !contains(arm_vars, v) { arm_vars = push(arm_vars, v) } }
  }
  if len(arm_vars) > 0 {
    code = str.concat(code, str.concat("        AValue ", str.concat(str.join(arm_vars, ", "), str.concat(";", nl))))
  }

  for arm in arms {
    let pat = arm["pattern"]
    let guard = arm["guard"]
    let body = arm["body"]

    let cr = _emit_pat_cond(pat, "__match", bm, ctx, li)
    li = cr[1]
    lifted = concat_arr(lifted, cr[2])

    let mut has_guard = type_of(guard) != "void"
    if has_guard { if guard["tag"] == "Void" { has_guard = false } }

    code = str.concat(code, str.concat("        if (!__matched && ", str.concat(cr[0], str.concat(") \{", nl))))

    let br = _emit_pat_bind(pat, "__match", 3, bm, ctx, li)
    li = br[1]
    lifted = concat_arr(lifted, br[2])
    if len(br[0]) > 0 {
      code = str.concat(code, str.concat(br[0], nl))
    }

    if has_guard {
      let gr = emit_expr(guard, bm, ctx, li)
      li = gr[1]
      lifted = concat_arr(lifted, gr[2])
      code = str.concat(code, str.concat("            if (a_truthy(", str.concat(_tmp(guard, gr[0], ctx), str.concat(")) \{", nl))))

      let body_r = _emit_match_expr_body(body, bm, ctx, li)
      li = body_r[1]
      lifted = concat_arr(lifted, body_r[2])
      code = str.concat(code, str.concat("                __match_result = ", str.concat(body_r[0], str.concat(";", nl))))
      code = str.concat(code, str.concat("                __matched = 1;", nl))
      code = str.concat(code, str.concat("            \}", nl))
    } else {
      let body_r = _emit_match_expr_body(body, bm, ctx, li)
      li = body_r[1]
      lifted = concat_arr(lifted, body_r[2])
      code = str.concat(code, str.concat("            __match_result = ", str.concat(body_r[0], str.concat(";", nl))))
      code = str.concat(code, str.concat("            __matched = 1;", nl))
    }

    code = str.concat(code, str.concat("        \}", nl))
  }

  code = str.concat(code, str.concat("        if (!__matched) a_fatal(\"runtime error: \", a_string(\"non-exhaustive match\"));", nl))
  code = str.concat(code, str.concat("        __match_result;", nl))
  code = str.concat(code, "    \})")

  ret _RL(code, li, lifted)
}

fn _emit_match_expr_body(body, bm, ctx, li) {
  let mut lifted = []
  if type_of(body["stmts"]) == "array" {
    ; Block body -- emit all statements, then the last expression
    let stmts = body["stmts"]
    if len(stmts) == 0 { ret _R("a_void()", li) }
    let last = stmts[len(stmts) - 1]
    let nl = _newline_char()
    let mut preamble = ""
    let mut i = 0
    while i < len(stmts) - 1 {
      let sr = emit_stmt(stmts[i], 4, bm, ctx, li)
      preamble = str.concat(preamble, str.concat(sr[0], nl))
      li = sr[1]
      lifted = concat_arr(lifted, sr[2])
      i = i + 1
    }
    ; Last stmt is the value
    if last["tag"] == "ExprStmt" {
      let er = emit_expr(last["expr"], bm, ctx, li)
      if len(preamble) > 0 {
        ret _RL(str.concat("(\{", str.concat(nl, str.concat(preamble, str.concat("                ", str.concat(er[0], str.concat(";", str.concat(nl, "            \})"))))))), er[1], concat_arr(lifted, er[2]))
      }
      ret _RL(er[0], er[1], concat_arr(lifted, er[2]))
    }
    if last["tag"] == "Return" {
      if type_of(last["expr"]) != "void" {
        let er = emit_expr(last["expr"], bm, ctx, li)
        if len(preamble) > 0 {
          ret _RL(str.concat("(\{", str.concat(nl, str.concat(preamble, str.concat("                ", str.concat(er[0], str.concat(";", str.concat(nl, "            \})"))))))), er[1], concat_arr(lifted, er[2]))
        }
        ret _RL(er[0], er[1], concat_arr(lifted, er[2]))
      }
    }
    ret _R("a_void()", li)
  }
  ; Single expression body
  ret emit_expr(body, bm, ctx, li)
}

; --- Statement emission ---
; Returns [code, li, [lifted_fns]]

; Every statement is preceded by a `#line` directive pointing at its `a`
; source, so C compiler diagnostics, sanitizer reports and debuggers all
; speak in terms of the program the user wrote. Callers must splice statement
; code at the start of a line (see the `else if` case).
fn emit_stmt(node, depth: int, bm, ctx, li) {
  let mut r = _emit_stmt(node, depth, bm, ctx, li)
  if type_of(node) == "map" && map.has(node, "line") && node["line"] > 0 && map.has(ctx, "file") && len(ctx["file"]) > 0 {
    ; #line maps C compiler messages back to the a source; A_LINE keeps the
    ; shadow frame's line current for runtime stack traces (fn bodies only)
    let mut line_stmt = ""
    if map.has(ctx, "cleanup_vars") {
      line_stmt = "A_LINE(" + to_str(node["line"]) + ");"
      if _stmt_has_temps(node) { r[0] = _tmp_scope(_indent(depth), r[0]) }
    }
    r[0] = "#line " + to_str(node["line"]) + " \"" + ctx["file"] + "\"\n" + line_stmt + r[0]
  }
  ret r
}

; Statements whose C code cannot register a temporary skip the scope block.
fn _stmt_has_temps(node) -> bool {
  let tag = node["tag"]
  if tag == "Break" || tag == "Continue" { ret false }
  if tag == "Let" || tag == "Assign" || tag == "Return" || tag == "ExprStmt" {
    if tag == "Assign" && node["target"]["tag"] != "Ident" { ret true }
    let v = node["expr"]
    if tag == "Let" || tag == "Assign" { v = node["value"] }
    if type_of(v) != "map" { ret false }
    let t = v["tag"]
    if t == "Ident" || t == "Int" || t == "Float" || t == "Bool" || t == "Void" { ret false }
    if t == "String" && tag != "ExprStmt" { ret false }
  }
  ret true
}

; "\n    A_LINE(n);" for a node with a known source line, "" otherwise.
fn _line_stmt(node, depth: int) -> str {
  if type_of(node) == "map" && map.has(node, "line") && node["line"] > 0 {
    ret "\n" + _indent(depth) + "A_LINE(" + to_str(node["line"]) + ");"
  }
  ret ""
}

fn _ctx_file(ctx) -> str {
  if type_of(ctx) == "map" && map.has(ctx, "file") { ret ctx["file"] }
  ret ""
}

; A C string literal for a plain name/path (no escapes needed beyond quotes and backslashes).
fn _c_str(v: str) -> str {
  ret "\"" + str.replace(str.replace(v, "\\", "\\\\"), "\"", "\\\"") + "\""
}

fn _emit_stmt(node, depth: int, bm, ctx, li) {
  let tag = node["tag"]
  let ind = _indent(depth)

  if tag == "Let" {
    let vr = emit_expr(node["value"], bm, ctx, li)
    let vname = _mangle(node["name"])
    let assign_expr = vr[0]
    let mut code = ""
    if _is_ident(node["value"]) {
      code = str.concat(ind, str.concat("\{ AValue __old = ", str.concat(vname, str.concat("; ", str.concat(vname, str.concat(" = a_retain(", str.concat(assign_expr, "); a_release(__old); \}")))))))
    } else {
      code = str.concat(ind, str.concat("\{ AValue __old = ", str.concat(vname, str.concat("; ", str.concat(vname, str.concat(" = ", str.concat(assign_expr, "; a_release(__old); \}")))))))
    }
    ret _RL(code, vr[1], vr[2])
  }

  if tag == "LetDestructure" {
    let vr = emit_expr(node["value"], bm, ctx, li)
    ; __dest is released in the epilogue, so it must own its reference: retain
    ; when the value is a variable that is itself released there.
    let mut src = vr[0]
    if _is_ident(node["value"]) { src = "a_retain(" + src + ")" }
    let mut code = ind + "\{ AValue __old = __dest; __dest = " + src + "; a_release(__old); \}"
    let bindings = node["bindings"]
    let mut i = 0
    for b in bindings {
      if b != "" && b != "_" {
        let mb = _mangle(b)
        code = code + "\n" + ind + "\{ AValue __old = " + mb + "; " + mb + " = a_array_get(__dest, a_int(" + to_str(i) + ")); a_release(__old); \}"
      }
      i = i + 1
    }
    let rest_name = node["rest"]
    if rest_name != "" {
      let mr = _mangle(rest_name)
      code = code + "\n" + ind + "\{ AValue __old = " + mr + "; " + mr + " = a_drop(__dest, a_int(" + to_str(len(bindings)) + ")); a_release(__old); \}"
    }
    ret _RL(code, vr[1], vr[2])
  }

  if tag == "Assign" {
    let target = node["target"]
    if target["tag"] == "Ident" {
      let tname = _mangle(target["name"])
      ; `xs = push(xs, v)` / `m = map.set(m, k, v)`: the variable's own
      ; reference is consumed by the call, so the runtime may update in place
      ; when nobody else holds the value. Turns the ubiquitous accumulate
      ; loop from O(n^2) into O(n).
      let upd = _self_update_builtin(node, target["name"])
      if upd == "push" {
        let an = node["value"]["args"][1]
        let ar = emit_expr(an, bm, ctx, li)
        let code = ind + tname + " = a_array_push_move(" + tname + ", " + _tmp(an, ar[0], ctx) + ");"
        ret _RL(code, ar[1], ar[2])
      }
      if upd == "map.set" {
        let kn = node["value"]["args"][1]
        let vn = node["value"]["args"][2]
        let kr = emit_expr(kn, bm, ctx, li)
        let vr2 = emit_expr(vn, bm, ctx, kr[1])
        let code = ind + tname + " = a_map_set_move(" + tname + ", " + _tmp(kn, kr[0], ctx) + ", " + _tmp(vn, vr2[0], ctx) + ");"
        ret _RL(code, vr2[1], concat_arr(kr[2], vr2[2]))
      }
      let vr = emit_expr(node["value"], bm, ctx, li)
      let assign_expr = vr[0]
      let mut code = ""
      if _is_ident(node["value"]) {
        code = str.concat(ind, str.concat("\{ AValue __old = ", str.concat(tname, str.concat("; ", str.concat(tname, str.concat(" = a_retain(", str.concat(assign_expr, "); a_release(__old); \}")))))))
      } else {
        code = str.concat(ind, str.concat("\{ AValue __old = ", str.concat(tname, str.concat("; ", str.concat(tname, str.concat(" = ", str.concat(assign_expr, "; a_release(__old); \}")))))))
      }
      ret _RL(code, vr[1], vr[2])
    }
    if target["tag"] == "Index" {
      if target["expr"]["tag"] != "Ident" {
        _compile_error(node, ctx, "cannot assign through a nested index; bind the inner collection to a variable, update it, then store it back")
      }
      let vr = emit_expr(node["value"], bm, ctx, li)
      let tr = emit_expr(target["expr"], bm, ctx, vr[1])
      let ir = emit_expr(target["index"], bm, ctx, tr[1])
      ; the variable's own reference is consumed; the runtime updates in place
      ; when it is the only one, otherwise copies and drops the old array
      let code = ind + tr[0] + " = a_index_set_move(" + tr[0] + ", " + _tmp(target["index"], ir[0], ctx) + ", " + _tmp(node["value"], vr[0], ctx) + ");"
      ret _RL(code, ir[1], concat_arr(vr[2], concat_arr(tr[2], ir[2])))
    }
    _compile_error(node, ctx, "invalid assignment target")
  }

  if tag == "Return" {
    let use_goto = type_of(ctx["goto_cleanup"]) == "bool" && ctx["goto_cleanup"]
    let cleanup_vars = ctx["cleanup_vars"]
    let has_cleanup = type_of(cleanup_vars) == "array" && len(cleanup_vars) > 0
    if type_of(node["expr"]) == "void" {
      if use_goto {
        ret _R(str.concat(ind, "goto __fn_cleanup;"), li)
      }
      if has_cleanup {
        let cleanup = _emit_exit_cleanup(cleanup_vars, depth)
        ret _R(str.concat(ind, str.concat("\{", str.concat(cleanup, str.concat("\n", str.concat(ind, "return a_void(); \}"))))), li)
      }
      ret _R(str.concat(ind, "return a_void();"), li)
    }
    let vr = emit_expr(node["expr"], bm, ctx, li)
    if use_goto {
      let val_expr = vr[0]
      if _is_ident(node["expr"]) {
        val_expr = str.concat("a_retain(", str.concat(vr[0], ")"))
      }
      ret _RL(str.concat(ind, str.concat("__ret = ", str.concat(val_expr, "; goto __fn_cleanup;"))), vr[1], vr[2])
    }
    if has_cleanup {
      let val_expr = vr[0]
      let ret_expr = val_expr
      if _is_ident(node["expr"]) {
        ret_expr = str.concat("a_retain(", str.concat(val_expr, ")"))
      }
      let cleanup = _emit_exit_cleanup(cleanup_vars, depth)
      let code = str.concat(ind, str.concat("\{ AValue __ret = ", str.concat(ret_expr, str.concat(";", str.concat(cleanup, str.concat("\n", str.concat(ind, "return __ret; \}")))))))
      ret _RL(code, vr[1], vr[2])
    }
    ret _RL(str.concat(ind, str.concat("return ", str.concat(vr[0], ";"))), vr[1], vr[2])
  }

  if tag == "ExprStmt" {
    let er = emit_expr(node["expr"], bm, ctx, li)
    ; the result is discarded: park it so the statement's flush releases it
    ret _RL(ind + _tmp(node["expr"], er[0], ctx) + ";", er[1], er[2])
  }

  if tag == "If" {
    let cr = emit_expr(node["cond"], bm, ctx, li)
    li = cr[1]
    let mut lifted = cr[2]
    let mut out = ind + "if (a_truthy(" + _tmp(node["cond"], cr[0], ctx) + ")) \{"
    let then_stmts = node["then"]["stmts"]
    for s in then_stmts {
      let sr = emit_stmt(s, depth + 1, bm, ctx, li)
      out = str.concat(out, str.concat("\n", sr[0]))
      li = sr[1]
      lifted = concat_arr(lifted, sr[2])
    }
    out = str.concat(out, str.concat("\n", str.concat(ind, "\}")))
    let else_branch = node["else"]
    if type_of(else_branch) != "void" {
      if else_branch["tag"] == "ElseBlock" {
        out = str.concat(out, " else \{")
        let else_stmts = else_branch["block"]["stmts"]
        for s in else_stmts {
          let sr = emit_stmt(s, depth + 1, bm, ctx, li)
          out = str.concat(out, str.concat("\n", sr[0]))
          li = sr[1]
          lifted = concat_arr(lifted, sr[2])
        }
        out = str.concat(out, str.concat("\n", str.concat(ind, "\}")))
      }
      if else_branch["tag"] == "ElseIf" {
        let sr = emit_stmt(else_branch["stmt"], depth, bm, ctx, li)
        out = str.concat(out, str.concat(" else\n", sr[0]))
        li = sr[1]
        lifted = concat_arr(lifted, sr[2])
      }
    }
    ret _RL(out, li, lifted)
  }

  if tag == "While" {
    let cr = emit_expr(node["cond"], bm, ctx, li)
    li = cr[1]
    let mut lifted = cr[2]
    ; temporaries of the condition and of statements left via `continue`/`break`
    ; are flushed at the top of every iteration rather than after the loop
    let mut out = ind + "\{ int __tm_it = a_tmp_sp;\n" + ind + "while (1) \{ a_tmp_release(__tm_it);\n"
    out = out + _indent(depth + 1) + "if (!a_truthy(" + _tmp(node["cond"], cr[0], ctx) + ")) break;"
    let body_ctx = map.set(ctx, "loop_cleanup", [])
    let body_stmts = node["body"]["stmts"]
    for s in body_stmts {
      let sr = emit_stmt(s, depth + 1, bm, body_ctx, li)
      out = str.concat(out, str.concat("\n", sr[0]))
      li = sr[1]
      lifted = concat_arr(lifted, sr[2])
    }
    out = out + "\n" + ind + "\} \}"
    ret _RL(out, li, lifted)
  }

  if tag == "For" {
    let var_name = _mangle(node["var"])
    let ir = emit_expr(node["iter"], bm, ctx, li)
    li = ir[1]
    let mut lifted = ir[2]
    let mut out = str.concat(ind, "\{")
    out = out + "\n" + _indent(depth + 1) + "AValue __iter_arr = a_iterable(" + _tmp(node["iter"], ir[0], ctx) + ");"
    out = out + "\n" + _indent(depth + 1) + "int __tm_it = a_tmp_sp;"
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 1), "for (int __fi = 0; __fi < a_ilen(__iter_arr); __fi++) \{ a_tmp_release(__tm_it);")))
    let mut body_vars = _collect_vars_in_stmts(node["body"]["stmts"])
    let mut for_decls = [var_name]
    for v in body_vars {
      if !contains(for_decls, v) { for_decls = push(for_decls, v) }
    }
    let mut init_parts = []
    for v in for_decls { init_parts = push(init_parts, str.concat(v, " = \{0\}")) }
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 2), str.concat("AValue ", str.concat(str.join(init_parts, ", "), ";")))))
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 2), str.concat(var_name, " = a_array_get(__iter_arr, a_int(__fi));"))))
    ; the loop variable is capturable by lambdas in the body; `break`/`continue`
    ; must release the per-iteration variables they skip past
    let mut body_ctx = _with_enclosing(ctx, [node["var"]])
    body_ctx = map.set(body_ctx, "loop_cleanup", for_decls)
    let body_stmts = node["body"]["stmts"]
    for s in body_stmts {
      let sr = emit_stmt(s, depth + 2, bm, body_ctx, li)
      out = str.concat(out, str.concat("\n", sr[0]))
      li = sr[1]
      lifted = concat_arr(lifted, sr[2])
    }
    let for_cleanup = _emit_cleanup(for_decls, depth + 2)
    out = str.concat(out, for_cleanup)
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 1), "\}")))
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 1), "a_release(__iter_arr);")))
    out = str.concat(out, str.concat("\n", str.concat(ind, "\}")))
    ret _RL(out, li, lifted)
  }

  if tag == "ForDestructure" {
    let bindings = node["bindings"]
    let ir = emit_expr(node["iter"], bm, ctx, li)
    li = ir[1]
    let mut lifted = ir[2]
    let mut out = str.concat(ind, "\{")
    out = out + "\n" + _indent(depth + 1) + "AValue __iter_arr = a_iterable(" + _tmp(node["iter"], ir[0], ctx) + ");"
    out = out + "\n" + _indent(depth + 1) + "int __tm_it = a_tmp_sp;"
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 1), "for (int __fi = 0; __fi < a_ilen(__iter_arr); __fi++) \{ a_tmp_release(__tm_it);")))
    ; Collect all variables to declare
    let mut decls = ["__elem"]
    for b in bindings { decls = push(decls, _mangle(b)) }
    let mut body_vars = _collect_vars_in_stmts(node["body"]["stmts"])
    for v in body_vars { if !contains(decls, v) { decls = push(decls, v) } }
    let mut init_parts = []
    for v in decls { init_parts = push(init_parts, str.concat(v, " = \{0\}")) }
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 2), str.concat("AValue ", str.concat(str.join(init_parts, ", "), ";")))))
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 2), "__elem = a_array_get(__iter_arr, a_int(__fi));")))
    let mut bi = 0
    for b in bindings {
      out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 2), str.concat(_mangle(b), str.concat(" = a_array_get(__elem, a_int(", str.concat(to_str(bi), "));"))))))
      bi = bi + 1
    }
    let mut body_ctx = _with_enclosing(ctx, bindings)
    body_ctx = map.set(body_ctx, "loop_cleanup", decls)
    let body_stmts = node["body"]["stmts"]
    for s in body_stmts {
      let sr = emit_stmt(s, depth + 2, bm, body_ctx, li)
      out = str.concat(out, str.concat("\n", sr[0]))
      li = sr[1]
      lifted = concat_arr(lifted, sr[2])
    }
    let fd_cleanup = _emit_cleanup(decls, depth + 2)
    out = str.concat(out, fd_cleanup)
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 1), "\}")))
    out = str.concat(out, str.concat("\n", str.concat(_indent(depth + 1), "a_release(__iter_arr);")))
    out = str.concat(out, str.concat("\n", str.concat(ind, "\}")))
    ret _RL(out, li, lifted)
  }

  if tag == "Match" { ret _emit_match(node, depth, bm, ctx, li) }

  if tag == "Break" || tag == "Continue" {
    let mut jump = "break;"
    if tag == "Continue" { jump = "continue;" }
    ; leaving a `for` body early skips its per-iteration releases
    let lc = ctx["loop_cleanup"]
    if type_of(lc) == "array" && len(lc) > 0 {
      ret _R(ind + "\{" + _emit_cleanup(lc, depth + 1) + "\n" + ind + jump + " \}", li)
    }
    ret _R(ind + jump, li)
  }

  ret _R(str.concat(ind, str.concat("/* unhandled stmt: ", str.concat(tag, " */"))), li)
}

; --- Variable collection (for pre-declaration) ---

fn _collect_pattern_vars(pat) -> [str] {
  let tag = pat["tag"]
  if tag == "PatIdent" { ret [_mangle(pat["name"])] }
  if tag == "PatRest" { ret [_mangle(pat["name"])] }
  if tag == "PatWildcard" { ret [] }
  if tag == "PatLiteral" { ret [] }
  if tag == "PatConstructor" {
    let mut vs = []
    for a in pat["args"] { vs = concat_arr(vs, _collect_pattern_vars(a)) }
    ret vs
  }
  if tag == "PatArray" {
    let mut vs = []
    for e in pat["elems"] {
      if e["tag"] == "PatElem" { vs = concat_arr(vs, _collect_pattern_vars(e["pattern"])) }
      if e["tag"] == "PatRest" { vs = push(vs, _mangle(e["name"])) }
    }
    ret vs
  }
  if tag == "PatMap" {
    let mut vs = []
    for e in pat["entries"] { vs = concat_arr(vs, _collect_pattern_vars(e["pattern"])) }
    ret vs
  }
  ret []
}

fn _collect_vars_in_stmts(stmts) -> [str] {
  let mut vars = []
  for s in stmts {
    let tag = s["tag"]
    if tag == "Let" {
      let name = _mangle(s["name"])
      if !contains(vars, name) { vars = push(vars, name) }
    }
    if tag == "If" {
      let tv = _collect_vars_in_stmts(s["then"]["stmts"])
      for v in tv { if !contains(vars, v) { vars = push(vars, v) } }
      let eb = s["else"]
      if type_of(eb) != "void" {
        if eb["tag"] == "ElseBlock" {
          let ev = _collect_vars_in_stmts(eb["block"]["stmts"])
          for v in ev { if !contains(vars, v) { vars = push(vars, v) } }
        }
        if eb["tag"] == "ElseIf" {
          let eiv = _collect_vars_in_stmts([eb["stmt"]])
          for v in eiv { if !contains(vars, v) { vars = push(vars, v) } }
        }
      }
    }
    if tag == "While" {
      let wv = _collect_vars_in_stmts(s["body"]["stmts"])
      for v in wv { if !contains(vars, v) { vars = push(vars, v) } }
    }
    if tag == "For" {
      let fv = _collect_vars_in_stmts(s["body"]["stmts"])
      for v in fv { if !contains(vars, v) { vars = push(vars, v) } }
    }
    if tag == "LetDestructure" {
      if !contains(vars, "__dest") { vars = push(vars, "__dest") }
      for b in s["bindings"] {
        if b != "" && b != "_" {
          let name = _mangle(b)
          if !contains(vars, name) { vars = push(vars, name) }
        }
      }
      let rn = s["rest"]
      if rn != "" {
        let name = _mangle(rn)
        if !contains(vars, name) { vars = push(vars, name) }
      }
    }
    if tag == "ForDestructure" {
      let fv = _collect_vars_in_stmts(s["body"]["stmts"])
      for v in fv { if !contains(vars, v) { vars = push(vars, v) } }
    }
    if tag == "Match" {
      for arm in s["arms"] {
        let pv = _collect_pattern_vars(arm["pattern"])
        for v in pv { if !contains(vars, v) { vars = push(vars, v) } }
        let body = arm["body"]
        if type_of(body["stmts"]) == "array" {
          let bv = _collect_vars_in_stmts(body["stmts"])
          for v in bv { if !contains(vars, v) { vars = push(vars, v) } }
        }
      }
    }
  }
  ret vars
}

; --- Function emission ---

fn emit_fn(node, bm, ctx, li) {
  let name = node["name"]
  let full_name = _prefixed_name(name, ctx)
  let params = node["params"]
  let body = node["body"]

  let mut param_parts = []
  for p in params {
    param_parts = push(param_parts, str.concat("AValue ", _mangle(p["name"])))
  }
  let param_str = str.join(param_parts, ", ")
  if len(params) == 0 { param_str = "void" }

  let mut out = str.concat("AValue fn_", str.concat(_mangle(full_name), str.concat("(", str.concat(param_str, ") \{"))))

  ; Pre-declare all local variables
  let all_vars = _collect_vars_in_stmts(body["stmts"])
  let mut param_names = []
  for p in params { param_names = push(param_names, _mangle(p["name"])) }
  let mut decl_vars = []
  for v in all_vars {
    if !contains(param_names, v) {
      if !contains(decl_vars, v) { decl_vars = push(decl_vars, v) }
    }
  }
  if len(decl_vars) > 0 {
    let mut init_parts = []
    for v in decl_vars { init_parts = push(init_parts, str.concat(v, " = \{0\}")) }
    out = str.concat(out, str.concat("\n    AValue ", str.concat(str.join(init_parts, ", "), ";")))
  }
  out = str.concat(out, "\n    AValue __ret = a_void();")
  out = out + "\n    A_FRAME(" + _c_str(name) + ", " + _c_str(_ctx_file(ctx)) + ");"
  out = out + "\n    int __tm0 = a_tmp_sp;"

  ; Retain function parameters so the function owns its copies
  for p in params {
    let pn = _mangle(p["name"])
    out = str.concat(out, str.concat("\n    ", str.concat(pn, str.concat(" = a_retain(", str.concat(pn, ");")))))
  }

  let all_cleanup_vars = concat_arr(decl_vars, param_names)

  ; Build enclosing_vars for lambda capture analysis
  let mut enc_vars = []
  for p in params { enc_vars = push(enc_vars, p["name"]) }
  for v in all_vars { if !contains(enc_vars, _mangle(v)) { enc_vars = push(enc_vars, v) } }
  let fn_ctx = map.set(ctx, "enclosing_vars", enc_vars)
  fn_ctx = map.set(fn_ctx, "cleanup_vars", all_cleanup_vars)
  fn_ctx = map.set(fn_ctx, "goto_cleanup", true)
  fn_ctx = map.set(fn_ctx, "fn_name", name)

  ; Escape analysis result stored in context for Phase 4 arena allocation
  fn_ctx = map.set(fn_ctx, "escaping_vars", [])

  let mut lifted = []
  let precond = node["pre"]
  if type_of(precond) == "map" && precond["tag"] != "Void" {
    let pr = emit_expr(precond, bm, fn_ctx, li)
    li = pr[1]
    lifted = concat_arr(lifted, pr[2])
    out = out + "\n#ifndef A_RELEASE"
    out = out + "\n    \{ int __tm = a_tmp_sp;"
    out = out + "\n        AValue __pre = " + _tmp(precond, pr[0], fn_ctx) + ";"
    out = out + "\n        if (!a_truthy(__pre)) a_fatal(\"precondition failed: \", a_string(" + _c_str(name) + "));"
    out = out + "\n        a_tmp_release(__tm); \}"
    out = out + "\n#endif"
  }

  let stmts = body["stmts"]
  for s in stmts {
    let sr = emit_stmt(s, 1, bm, fn_ctx, li)
    out = str.concat(out, str.concat("\n", sr[0]))
    li = sr[1]
    lifted = concat_arr(lifted, sr[2])
  }

  let mut post_code = ""
  let postcond = node["post"]
  if type_of(postcond) == "map" && postcond["tag"] != "Void" {
    let por = emit_expr(postcond, bm, fn_ctx, li)
    li = por[1]
    lifted = concat_arr(lifted, por[2])
    post_code = "\n#ifndef A_RELEASE"
    post_code = post_code + "\n    \{ int __tm = a_tmp_sp;"
    post_code = post_code + "\n        AValue ret = a_retain(__ret);"
    post_code = post_code + "\n        AValue __post = " + _tmp(postcond, por[0], fn_ctx) + ";"
    post_code = post_code + "\n        if (!a_truthy(__post)) a_fatal(\"postcondition failed: \", a_string(" + _c_str(name) + "));"
    post_code = post_code + "\n        a_release(ret);"
    post_code = post_code + "\n        a_tmp_release(__tm); \}"
    post_code = post_code + "\n#endif"
  }

  out = str.concat(out, "\n__fn_cleanup:")
  out = out + post_code
  let cleanup = _emit_exit_cleanup(all_cleanup_vars, 1)
  out = str.concat(out, str.concat(cleanup, "\n    return __ret;"))

  out = str.concat(out, "\n\}\n")
  ret _RL(out, li, lifted)
}

fn _emit_fwd_decl(name, params) -> str {
  let mut param_parts = []
  for p in params {
    param_parts = push(param_parts, str.concat("AValue ", _mangle(p["name"])))
  }
  let param_str = str.join(param_parts, ", ")
  if len(params) == 0 { param_str = "void" }
  ret str.concat("AValue fn_", str.concat(_mangle(name), str.concat("(", str.concat(param_str, ");"))))
}

; --- Module loading ---

fn _dirname(p: str) -> str {
  let mut i = len(p) - 1
  while i >= 0 {
    if str.slice(p, i, i + 1) == "/" {
      if i == 0 { ret "/" }
      ret str.slice(p, 0, i)
    }
    i = i - 1
  }
  ret "."
}

; Where the `a` installation lives: the directory holding `std/` and
; `c_runtime/`. `$A_ROOT` if set; otherwise the directory of the running
; binary or its parent. "" when neither has a `std/`. This is what lets a
; program in any directory `use std.x` and be built there.
fn install_root() -> str {
  let e = env.get("A_ROOT")
  if type_of(e) == "str" && len(e) > 0 { ret e }
  let mut exe = "/proc/self/exe"
  if !fs.exists(exe) { exe = argv0() }
  let real = fs.abs(exe)
  if type_of(real) != "str" { ret "" }
  let d = _dirname(real)
  if fs.exists(str.concat(d, "/std")) { ret d }
  let parent = _dirname(d)
  if fs.exists(str.concat(parent, "/std")) { ret parent }
  ret ""
}

; A module is looked up next to the program first (a project's own modules
; and `a_modules/` from `a pkg`), then in the installation's `std/`.
fn _use_path_to_file(path_arr) -> str {
  let rel = str.concat(str.join(path_arr, "/"), ".a")
  if fs.exists(rel) { ret rel }
  let mod_path = str.concat("a_modules/", rel)
  if fs.exists(mod_path) { ret mod_path }
  let root = install_root()
  if len(root) > 0 {
    let installed = str.concat(root, str.concat("/", rel))
    if fs.exists(installed) { ret installed }
  }
  ret rel
}

fn _use_path_short_name(path_arr) -> str {
  ret path_arr[len(path_arr) - 1]
}

fn _collect_fn_names(items) -> [str] {
  let mut names = []
  for item in items {
    if item["tag"] == "FnDecl" {
      names = push(names, item["name"])
    }
  }
  ret names
}

;  Sum-type constructors declared by `ty T = A(x) | B(x, y) | C`: name -> arity.
fn _collect_variants(items) -> map {
  let mut out = #{}
  for item in items {
    if item["tag"] != "TypeDecl" { continue }
    let body = item["body"]
    if type_of(body) != "map" || body["tag"] != "TypeSum" { continue }
    for v in body["variants"] {
      if type_of(v) == "map" { out = map.set(out, v["name"], len(v["fields"])) }
    }
  }
  ret out
}

fn _variant_arity(ctx, name) -> int {
  if type_of(ctx) != "map" || !map.has(ctx, "variants") { ret -1 }
  let vs = ctx["variants"]
  if !map.has(vs, name) { ret -1 }
  ret vs[name]
}

; Parse cache shared by the checker, effect analysis, and codegen so a
; module is read and parsed once per process, not once per consumer.
fn empty_parse_cache() -> map { ret #{} }

fn load_module_source(path_arr, cache) -> map {
  let file_path = _use_path_to_file(path_arr)
  if map.has(cache, file_path) {
    ret #{"cache": cache, "got": cache[file_path]}
  }
  let rel = str.concat(str.join(path_arr, "/"), ".a")
  ; The file on disk is the source an editor just saved. The copy embedded
  ; in the compiler binary is only the fallback for an install that shipped
  ; without its std/ tree.
  let mut source = ""
  let mut saw_disk = false
  if fs.exists(file_path) {
    let disk = io.read_file(file_path)
    if type_of(disk) == "str" {
      source = disk
      saw_disk = true
    }
  }
  if !saw_disk {
    let emb = embedded_file(rel)
    if type_of(emb) == "str" { source = emb }
  }
  let mut got = #{"status": "missing", "file": file_path, "rel": rel, "source": source}
  if type_of(source) == "str" && len(source) > 0 {
    let ast = parser.parse(source)
    if type_of(ast) == "map" && map.has(ast, "tag") && ast["tag"] == "ParseError" {
      let mut line = 0
      let mut col = 0
      if map.has(ast, "line") { line = ast["line"] }
      if map.has(ast, "col") { col = ast["col"] }
      got = #{"status": "parse", "file": file_path, "rel": rel, "ast": ast, "msg": ast["msg"], "line": line, "col": col, "source": source}
    } else {
      got = #{"status": "ok", "file": file_path, "rel": rel, "ast": ast, "source": source}
    }
  }
  ret #{"cache": map.set(cache, file_path, got), "got": got}
}

fn _load_module(path_arr, bm, loaded, li, cache) -> map {
  let use_key = str.join(path_arr, ".")
  ; A module reached twice (a diamond) is emitted once, but every importer
  ; still needs its prototypes: `loaded` maps each module to them.
  if map.has(loaded, use_key) {
    ret #{"fwd": loaded[use_key], "fns": [], "units": [], "loaded": loaded, "li": li, "cache": cache}
  }
  loaded = map.set(loaded, use_key, [])

  let pr = load_module_source(path_arr, cache)
  cache = pr["cache"]
  let got = pr["got"]
  let file_path = got["file"]
  if got["status"] == "missing" {
    fail("cannot load module " + use_key + ": file not found: " + file_path)
  }
  if got["status"] == "parse" {
    let mut loc = file_path
    if got["line"] > 0 { loc = file_path + ":" + to_str(got["line"]) + ":" + to_str(got["col"]) }
    fail(loc + ": error: " + got["msg"] + " (while loading module " + use_key + ")")
  }
  let mod_ast = got["ast"]
  let items = mod_ast["items"]
  let short = _use_path_short_name(path_arr)

  let mut sub_fwd = []
  let mut sub_fns = []
  let mut units = []

  for item in items {
    if item["tag"] == "UseDecl" {
      let sub = _load_module(item["path"], bm, loaded, li, cache)
      loaded = sub["loaded"]
      cache = sub["cache"]
      sub_fwd = concat_arr(sub_fwd, sub["fwd"])
      sub_fns = concat_arr(sub_fns, sub["fns"])
      units = concat_arr(units, sub["units"])
    }
  }

  let fn_names = _collect_fn_names(items)
  let variants = _collect_variants(items)
  let ctx = #{"prefix": short, "fns": fn_names, "file": file_path, "variants": variants}
  let mut aliases = #{}
  let mut own_fwd = []
  let mut own_fns = []

  ; Lambda numbering restarts in every unit (names carry the module prefix),
  ; so a module's C text depends on nothing but the module itself. That is
  ; what makes the text a valid cache key for its object file.
  let mut mli = 0
  for item in items {
    if item["tag"] == "FnDecl" {
      let full_name = _prefixed_name(item["name"], ctx)
      own_fwd = push(own_fwd, _emit_fwd_decl(full_name, item["params"]))
      let fr = emit_fn(item, bm, ctx, mli)
      mli = fr[1]
      for lf in fr[2] { own_fns = push(own_fns, lf) }
      own_fns = push(own_fns, fr[0])
      aliases = map.set(aliases, item["name"], full_name)
    }
  }

  let unit_c = _unit_text([], concat_arr(sub_fwd, own_fwd), own_fns, "")
  units = push(units, #{"name": use_key, "file": file_path, "c": unit_c})
  loaded = map.set(loaded, use_key, concat_arr(sub_fwd, own_fwd))

  ret #{"fwd": concat_arr(sub_fwd, own_fwd), "fns": concat_arr(sub_fns, own_fns), "units": units, "loaded": loaded, "li": li, "aliases": aliases, "variants": variants, "cache": cache}
}

; Lifted lambdas are named after the unit they live in, so numbering can
; restart per unit without two units ever producing the same name.
fn _lambda_name(ctx, li) -> str {
  let mut p = ""
  if map.has(ctx, "prefix") { p = ctx["prefix"] }
  if len(p) == 0 { p = "main" }
  ret str.concat("__lambda_", str.concat(_mangle(p), str.concat("_", to_str(li))))
}

; Prototypes for the lifted lambdas in a list of emitted functions. Lambdas
; are static, so each unit declares only its own.
fn _lambda_fwds(fns) -> [str] {
  let mut out = []
  for code in fns {
    if str.starts_with(code, "static AValue __lambda_") {
      let close = str.find(code, ") \{")
      if close > 0 { out = push(out, str.concat(str.slice(code, 0, close + 1), ";")) }
    }
  }
  ret out
}

; One C translation unit: prototypes for everything it may call, then its
; own functions. `tail` is the C `main` (only the program unit has one).
fn _unit_text(protos, fwd, fns, tail) -> str {
  let mut parts = ["#include \"runtime.h\"\n#include <stdlib.h>\n"]
  if len(protos) > 0 {
    parts = push(parts, "/* FFI extern prototypes */")
    parts = concat_arr(parts, protos)
    parts = push(parts, "")
  }
  let lfwd = _lambda_fwds(fns)
  if len(lfwd) > 0 {
    parts = push(parts, "/* Lambda forward declarations */")
    parts = concat_arr(parts, lfwd)
    parts = push(parts, "")
  }
  parts = push(parts, "/* Forward declarations */")
  parts = concat_arr(parts, fwd)
  parts = push(parts, "")
  parts = concat_arr(parts, fns)
  if len(tail) > 0 { parts = push(parts, tail) }
  ret str.concat(str.join(parts, "\n"), "\n")
}

; In a single translation unit every function can be static, which lets the
; C compiler drop whatever `main` does not reach before optimising it.
fn _staticize(decls) -> [str] {
  let mut out = []
  for d in decls {
    if str.starts_with(d, "AValue fn_") { out = push(out, str.concat("static ", d)) }
    else { out = push(out, d) }
  }
  ret out
}

; --- FFI type mapping ---

fn _ffi_c_type(ty_node) -> str {
  let tag = ty_node["tag"]
  if tag == "TyPrim" {
    let name = ty_node["name"]
    if name == "i8" { ret "int8_t" }
    if name == "i16" { ret "int16_t" }
    if name == "i32" { ret "int32_t" }
    if name == "i64" { ret "int64_t" }
    if name == "u8" { ret "uint8_t" }
    if name == "u16" { ret "uint16_t" }
    if name == "u32" { ret "uint32_t" }
    if name == "u64" { ret "uint64_t" }
    if name == "f32" { ret "float" }
    if name == "f64" { ret "double" }
    if name == "bool" { ret "int" }
    if name == "str" { ret "const char*" }
    if name == "ptr" { ret "void*" }
    if name == "void" { ret "void" }
  }
  ret "AValue"
}

fn _ffi_extract(ty_node, var_name) -> str {
  let tag = ty_node["tag"]
  if tag == "TyPrim" {
    let name = ty_node["name"]
    if name == "i8" || name == "i16" || name == "i32" {
      ret str.concat("(", str.concat(_ffi_c_type(ty_node), str.concat(")", str.concat(var_name, ".ival"))))
    }
    if name == "i64" { ret str.concat(var_name, ".ival") }
    if name == "u8" || name == "u16" || name == "u32" || name == "u64" {
      ret str.concat("(", str.concat(_ffi_c_type(ty_node), str.concat(")", str.concat(var_name, ".ival"))))
    }
    if name == "f32" { ret str.concat("(float)", str.concat(var_name, ".fval")) }
    if name == "f64" { ret str.concat(var_name, ".fval") }
    if name == "bool" { ret str.concat(var_name, ".bval") }
    if name == "str" { ret str.concat(var_name, ".sval->data") }
    if name == "ptr" { ret str.concat(var_name, ".pval") }
  }
  ret var_name
}

fn _ffi_wrap(ty_node, expr) -> str {
  let tag = ty_node["tag"]
  if tag == "TyPrim" {
    let name = ty_node["name"]
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" ||
       name == "u8" || name == "u16" || name == "u32" || name == "u64" {
      ret str.concat("a_int((int64_t)", str.concat(expr, ")"))
    }
    if name == "f32" || name == "f64" { ret str.concat("a_float((double)", str.concat(expr, ")")) }
    if name == "bool" { ret str.concat("a_bool(", str.concat(expr, ")")) }
    if name == "str" { ret str.concat("a_string(", str.concat(expr, ")")) }
    if name == "ptr" { ret str.concat("a_ptr(", str.concat(expr, ")")) }
    if name == "void" { ret "a_void()" }
  }
  ret expr
}

fn _emit_extern_fn(node) -> [str] {
  let name = node["name"]
  let params = node["params"]
  let ret_type = node["ret_type"]
  let c_ret = _ffi_c_type(ret_type)
  let is_void = c_ret == "void"

  ; Build raw C prototype: extern <c_ret> <name>(<c_param_types>);
  let mut c_param_parts = []
  for p in params {
    c_param_parts = push(c_param_parts, _ffi_c_type(p["type"]))
  }
  let c_param_str = str.join(c_param_parts, ", ")
  if len(params) == 0 { c_param_str = "void" }
  let raw_proto = str.concat("extern ", str.concat(c_ret, str.concat(" ", str.concat(name, str.concat("(", str.concat(c_param_str, ");"))))))

  ; Build AValue shim: AValue fn_<name>(AValue p0, ...) { ... }
  let mut shim_params = []
  let mut pi = 0
  while pi < len(params) {
    shim_params = push(shim_params, str.concat("AValue __p", to_str(pi)))
    pi = pi + 1
  }
  let shim_param_str = str.join(shim_params, ", ")
  if len(params) == 0 { shim_param_str = "void" }

  let mut shim = str.concat("static AValue fn_", str.concat(_mangle(name), str.concat("(", str.concat(shim_param_str, ") \{\n"))))

  ; Extract arguments
  let mut call_args = []
  pi = 0
  while pi < len(params) {
    let p = params[pi]
    let extracted = _ffi_extract(p["type"], str.concat("__p", to_str(pi)))
    call_args = push(call_args, extracted)
    pi = pi + 1
  }

  ; Emit call
  let call_str = str.concat(name, str.concat("(", str.concat(str.join(call_args, ", "), ")")))
  if is_void {
    shim = str.concat(shim, str.concat("    ", str.concat(call_str, ";\n")))
    shim = str.concat(shim, "    return a_void();\n")
  } else {
    shim = str.concat(shim, str.concat("    ", str.concat(c_ret, str.concat(" __result = ", str.concat(call_str, ";\n")))))
    shim = str.concat(shim, str.concat("    return ", str.concat(_ffi_wrap(ret_type, "__result"), ";\n")))
  }
  shim = str.concat(shim, "\}\n")

  ; Forward declaration for the shim
  let fwd = str.concat("static AValue fn_", str.concat(_mangle(name), str.concat("(", str.concat(shim_param_str, ");"))))

  ret [raw_proto, fwd, shim]
}

; --- Program emission ---

fn main_file_of(prog_ast) -> str {
  if map.has(prog_ast, "file") { ret prog_ast["file"] }
  ret ""
}

; Emits the program as compilation units: one per `use`d module plus the
; program itself. Each unit's C text depends only on that module's source
; (and the prototypes of what it imports), so callers can cache object files
; by hashing the text. Returns #{"main": str, "units": [#{"name", "file", "c"}]}.
fn emit_units(prog_ast, bm) -> map {
  ret emit_units_cached(prog_ast, bm, #{})
}

fn emit_units_cached(prog_ast, bm, cache) -> map {
  let items = prog_ast["items"]

  let mut mod_fwd = []
  let mut mod_fns = []
  let mut units = []
  let mut loaded = #{}
  let mut import_aliases = #{}
  let mut all_variants = _collect_variants(items)

  for item in items {
    if item["tag"] == "UseDecl" {
      let result = _load_module(item["path"], bm, loaded, 0, cache)
      loaded = result["loaded"]
      cache = result["cache"]
      mod_fwd = concat_arr(mod_fwd, result["fwd"])
      mod_fns = concat_arr(mod_fns, result["fns"])
      units = concat_arr(units, result["units"])
      let al = result["aliases"]
      if type_of(al) == "map" {
        for [k, v] in al { import_aliases = map.set(import_aliases, k, v) }
      }
      let mv = result["variants"]
      if type_of(mv) == "map" {
        for [k, v] in mv { all_variants = map.set(all_variants, k, v) }
      }
    }
  }

  let mut own_fwd = []
  let mut own_fns = []
  let mut li = 0

  ; Inline `mod m { ... }` blocks: their functions are emitted as m_f (like a
  ; `use`d module) and reachable both as `m.f(...)` and unqualified `f(...)`.
  for item in items {
    if item["tag"] == "ModDecl" {
      let mitems = item["items"]
      let mv = _collect_variants(mitems)
      for [k, v] in mv { all_variants = map.set(all_variants, k, v) }
      let mctx = #{"prefix": item["name"], "fns": _collect_fn_names(mitems), "import_aliases": import_aliases, "file": main_file_of(prog_ast), "variants": all_variants}
      for mi in mitems {
        if mi["tag"] == "FnDecl" {
          let full_name = _prefixed_name(mi["name"], mctx)
          own_fwd = push(own_fwd, _emit_fwd_decl(full_name, mi["params"]))
          let fr = emit_fn(mi, bm, mctx, li)
          li = fr[1]
          for lf in fr[2] { own_fns = push(own_fns, lf) }
          own_fns = push(own_fns, fr[0])
          import_aliases = map.set(import_aliases, mi["name"], full_name)
        }
      }
    }
  }

  let mut main_fn_names = _collect_fn_names(items)
  for [k, v] in import_aliases { main_fn_names = push(main_fn_names, k) }

  ; Collect extern fn names so call resolution treats them as known
  let mut extern_protos = []
  let mut extern_shims = []
  for item in items {
    if item["tag"] == "ExternFn" {
      main_fn_names = push(main_fn_names, item["name"])
      let parts = _emit_extern_fn(item)
      extern_protos = push(extern_protos, parts[0])
      own_fwd = push(own_fwd, parts[1])
      extern_shims = push(extern_shims, parts[2])
    }
  }

  let main_file = main_file_of(prog_ast)
  let main_ctx = #{"prefix": "", "fns": main_fn_names, "import_aliases": import_aliases, "file": main_file, "variants": all_variants}

  for item in items {
    if item["tag"] == "FnDecl" {
      own_fwd = push(own_fwd, _emit_fwd_decl(item["name"], item["params"]))
      let fr = emit_fn(item, bm, main_ctx, li)
      li = fr[1]
      for lf in fr[2] { own_fns = push(own_fns, lf) }
      own_fns = push(own_fns, fr[0])
    }
  }

  let mut entry = ""
  let mut exit_fn = "a_main_exit_code"
  if contains(_collect_fn_names(items), "main") {
    entry = "fn_main"
    ; `fn main() -> int`: the returned integer is the process exit status
    for item in items {
      if item["tag"] == "FnDecl" && item["name"] == "main" && _is_int_type(item["ret_type"]) { exit_fn = "a_main_exit_code_int" }
    }
  }
  else if map.has(import_aliases, "main") { entry = str.concat("fn_", _mangle(import_aliases["main"])) }
  if entry == "" {
    let tests = _nullary_test_names(items)
    if len(tests) > 0 {
      own_fwd = push(own_fwd, "AValue fn_main(void);")
      own_fns = push(own_fns, _emit_test_harness(tests, main_file))
      entry = "fn_main"
    } else {
      let mut where_ = main_file
      if len(where_) == 0 { where_ = "<program>" }
      fail(str.concat(where_, ": error: no `fn main` found -- a program needs a main function (use `a build` only on programs, not library modules)"))
    }
  }
  let mut tail = "int main(int argc, char** argv) \{\n"
  tail = str.concat(tail, "    g_argc = argc; g_argv = argv;\n")
  tail = str.concat(tail, str.concat("    return ", str.concat(exit_fn, str.concat("(", str.concat(entry, "());\n")))))
  tail = str.concat(tail, "\}\n")

  let main_fns = concat_arr(extern_shims, own_fns)
  let main_c = _unit_text(extern_protos, concat_arr(mod_fwd, own_fwd), main_fns, tail)
  let single = _unit_text(extern_protos, _staticize(concat_arr(mod_fwd, own_fwd)), _staticize(concat_arr(mod_fns, main_fns)), tail)

  ret #{"main": main_c, "units": units, "single": single}
}

fn _nullary_test_names(items) -> [str] {
  let mut names = []
  for item in items {
    if type_of(item) == "map" && item["tag"] == "FnDecl" {
      if str.starts_with(item["name"], "test_") && len(item["params"]) == 0 {
        names = push(names, item["name"])
      }
    }
  }
  ret names
}

fn _emit_test_harness(tests: [str], file: str) -> str {
  let mut out = "AValue fn_main(void) \{\n"
  out = out + "    A_FRAME(\"main\", " + _c_str(file) + ");\n"
  out = out + "    AValue __ret = a_void();\n"
  for t in tests {
    out = out + "    fn_" + _mangle(t) + "();\n"
  }
  out = out + "    return __ret;\n\}\n"
  ret out
}

fn _is_int_type(t) -> bool {
  if type_of(t) != "map" || !map.has(t, "tag") { ret false }
  if t["tag"] != "TyPrim" && t["tag"] != "TyNamed" { ret false }
  ret contains(["int", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"], t["name"])
}

; The whole program as one translation unit (what `a cc` prints).
fn emit_program(prog_ast, bm) -> str {
  ret emit_units(prog_ast, bm)["single"]
}

; --- Entry point ---

fn main() -> void effects [io, fs_read, env] {
  let file_args = args()
  if len(file_args) == 0 {
    eprintln("usage: a run std/compiler/cgen.a -- <input.a>")
    exit(1)
  }
  let source = io.read_file(file_args[0])
  let prog_ast = parser.parse(source)
  let bm = _builtin_map()
  let c_code = emit_program(prog_ast, bm)
  print(c_code)
}
