; Generates the builtin and standard-library sections of REFERENCE.md from the
; signature table and the source tree. Sections 1-11 and the closing example
; stay handwritten. `a doc --check` fails when the generated text is stale.

use std.compiler.builtin_sigs
use std.compiler.parser

fn _ns(name: str) -> str {
  let dot = str.find(name, ".")
  if dot < 0 { ret "core" }
  ret str.slice(name, 0, dot)
}

fn _ty(t) -> str {
  if type_of(t) != "map" { ret "" }
  let tag = t["tag"]
  if tag == "TyPrim" { ret t["name"] }
  if tag == "TyNamed" {
    let mut s = t["name"]
    if type_of(t["args"]) == "array" && len(t["args"]) > 0 {
      let mut args = []
      for a in t["args"] { args = push(args, _ty(a)) }
      s = s + "<" + str.join(args, ", ") + ">"
    }
    ret s
  }
  if tag == "TyArray" { ret "[" + _ty(t["elem"]) + "]" }
  if tag == "TyMap" { ret "#\{" + _ty(t["key"]) + ": " + _ty(t["val"]) + "\}" }
  if tag == "TyTuple" {
    let mut xs = []
    for e in t["elems"] { xs = push(xs, _ty(e)) }
    ret "(" + str.join(xs, ", ") + ")"
  }
  if tag == "TyFn" {
    let mut ps = []
    if type_of(t["params"]) == "array" {
      for p in t["params"] { ps = push(ps, _ty(p)) }
    }
    let mut s = "fn(" + str.join(ps, ", ") + ")"
    let r = _ty(t["ret"])
    if len(r) > 0 { s = s + " -> " + r }
    ret s
  }
  ret ""
}

fn _effects(names) -> str {
  if type_of(names) != "array" || len(names) == 0 { ret "pure" }
  let mut xs = []
  for n in names {
    if type_of(n) == "str" { xs = push(xs, n) }
  }
  if len(xs) == 0 { ret "pure" }
  ret str.join(xs, ", ")
}

fn builtins_md() -> str {
  let sigs = builtin_sigs.sigs()
  let fx = builtin_sigs.effect_table()
  let mut by_ns = #{}
  let mut order = []
  for name in sort(map.keys(sigs)) {
    let ns = _ns(name)
    if !map.has(by_ns, ns) {
      by_ns = map.set(by_ns, ns, [])
      order = push(order, ns)
    }
    by_ns = map.set(by_ns, ns, push(by_ns[ns], name))
  }
  let mut out = "## 12. Builtin Functions Reference\n\n"
  out = out + "Generated by `a doc` from `std/compiler/builtin_sigs.a`. Do not edit by hand.\n"
  out = out + "A builtin with no effect list is pure. `effects [pure]` on your function rejects every name in the Effects column.\n\n"
  for ns in order {
    out = out + "### " + ns + "\n\n"
    out = out + "| Function | Signature | Effects |\n|----------|-----------|----------|\n"
    for name in by_ns[ns] {
      out = out + "| `" + name + "(...)` | `" + sigs[name] + "` | " + _effects(fx[name]) + " |\n"
    }
    out = out + "\n"
  }
  ret out
}

fn _blurb(src: str) -> str {
  let mut parts = []
  for line in str.lines(src) {
    let t = str.trim(line)
    if len(t) == 0 {
      if len(parts) > 0 { break }
      continue
    }
    if !str.starts_with(t, ";") { break }
    let rest = str.trim(str.slice(t, 1, len(t)))
    if len(rest) == 0 { break }
    parts = push(parts, rest)
  }
  ret str.join(parts, " ")
}

fn _fn_sig(item) -> str {
  let mut ps = []
  for p in item["params"] {
    let typ = _ty(p["type"])
    if len(typ) == 0 { ps = push(ps, p["name"]) }
    else { ps = push(ps, p["name"] + ": " + typ) }
  }
  let mut sig = "fn(" + str.join(ps, ", ") + ")"
  let ret_ty = _ty(item["ret_type"])
  if len(ret_ty) > 0 { sig = sig + " -> " + ret_ty }
  ret sig
}

fn _fn_row(item) -> str {
  ret "| `" + item["name"] + "` | `" + _fn_sig(item) + "` |\n"
}

fn _module_md(title: str, path: str) -> str {
  let src = io.read_file(path)
  if type_of(src) != "str" { ret "### " + title + "\n\n(unreadable)\n\n" }
  let mut out = "### " + title + "\n\n"
  let blurb = _blurb(src)
  if len(blurb) > 0 { out = out + blurb + "\n\n" }
  let ast = parser.parse(src)
  if type_of(ast) != "map" || ast["tag"] != "Program" {
    out = out + "(this module does not parse)\n\n"
    ret out
  }
  let mut rows = ""
  for item in ast["items"] {
    if type_of(item) != "map" || item["tag"] != "FnDecl" { continue }
    if str.starts_with(item["name"], "_") { continue }
    rows = rows + _fn_row(item)
  }
  if len(rows) == 0 { ret out }
  out = out + "| Function | Signature |\n|----------|-----------|\n"
  out = out + rows + "\n"
  ret out
}

fn _a_files(dir: str) -> [str] {
  if !fs.exists(dir) { ret [] }
  let mut names = []
  for e in fs.ls(dir) {
    if !e["is_dir"] && str.ends_with(e["name"], ".a") { names = push(names, e["name"]) }
  }
  ret sort(names)
}

fn stdlib_md() -> str {
  let mut out = "## 13. Standard Library\n\n"
  out = out + "Generated by `a doc` from `std/*.a` and `std/compiler/*.a`. Do not edit by hand.\n"
  out = out + "Import with `use std.<module>`. Names starting with `_` are omitted.\n\n"
  for f in _a_files("std") {
    let stem = str.slice(f, 0, len(f) - 2)
    out = out + _module_md("std." + stem, "std/" + f)
  }
  out = out + "### Compiler modules\n\n"
  out = out + "These are the self-hosting toolchain. Import with `use std.compiler.<name>`.\n\n"
  out = out + "| Module | Summary |\n|--------|----------|\n"
  for f in _a_files("std/compiler") {
    let stem = str.slice(f, 0, len(f) - 2)
    let src = io.read_file("std/compiler/" + f)
    let mut blurb = ""
    if type_of(src) == "str" { blurb = _blurb(src) }
    out = out + "| `std.compiler." + stem + "` | " + blurb + " |\n"
  }
  out = out + "\n"
  ret out
}

fn generated() -> str {
  ret builtins_md() + "---\n\n" + stdlib_md() + "---\n\n"
}

fn splice(existing: str) -> str {
  let start_at = str.find(existing, "## 12. Builtin Functions Reference")
  let end_at = str.find(existing, "## 14. Complete Example")
  if start_at < 0 || end_at < 0 {
    fail("REFERENCE.md is missing section 12 or section 14")
  }
  ret str.slice(existing, 0, start_at) + generated() + str.slice(existing, end_at, len(existing))
}
