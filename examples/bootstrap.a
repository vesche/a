; Bootstrap proof for the native compiler.
;
; The installed `./a` (stage 0) compiles src/cli.a into stage 1; stage 1
; compiles the same sources into stage 2. If stage 1 and stage 2 generate
; byte-identical C for the compiler, the compiler is at a fixed point: it
; reproduces itself exactly. This is the check run before every release.
;
;   ./a run examples/bootstrap.a

fn step(label: str, cmd: str) -> map {
  eprintln("-> " + label)
  let r = exec_timeout(cmd, 0)
  if r["exit_code"] != 0 {
    eprintln("FAIL: " + cmd)
    eprintln(r["stderr"])
    exit(1)
  }
  ret r
}

fn main() {
  eprintln("=== Bootstrap Proof (native) ===")
  step("stage 0 (./a) builds stage 1", "./a build src/cli.a -o /tmp/bootstrap_s1")
  step("stage 1 builds stage 2", "/tmp/bootstrap_s1 build src/cli.a -o /tmp/bootstrap_s2")

  let c1 = step("stage 1 generates C for the compiler", "/tmp/bootstrap_s1 cc src/cli.a")
  let c2 = step("stage 2 generates C for the compiler", "/tmp/bootstrap_s2 cc src/cli.a")
  if c1["stdout"] != c2["stdout"] {
    eprintln("FAIL: stage 1 and stage 2 disagree about the compiler's own C")
    exit(1)
  }
  eprintln("-> fixed point: stage 1 and stage 2 emit identical C (" + to_str(len(c1["stdout"])) + " bytes)")

  io.write_file("/tmp/bootstrap_fib.a", "fn fib(n) \{ if n < 2 \{ ret n \}\n ret fib(n - 1) + fib(n - 2) \}\nfn main() \{ println(to_str(fib(10))) \}\n")
  let r = step("stage 2 runs a program", "/tmp/bootstrap_s2 run /tmp/bootstrap_fib.a")
  if str.trim(r["stdout"]) != "55" {
    eprintln("FAIL: expected 55, got " + r["stdout"])
    exit(1)
  }
  eprintln("=== BOOTSTRAP PROOF COMPLETE ===")
}
